{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Foodbook design tokens — canonical source of truth for palette, type scale, spacing, radii. Mirrors :root in src/styles/global.css. See docs/adr/0010-design-tokens.md.",
  "$version": 1,
  "color": {
    "bg":        { "$value": "#0a0d11",                       "$type": "color", "$description": "Page background, dark editorial mode." },
    "ink":       { "$value": "#faf8f4",                       "$type": "color", "$description": "Primary text on dark." },
    "ink-soft":  { "$value": "#c2c8d0",                       "$type": "color", "$description": "Secondary text — lead, body prose." },
    "ink-mute":  { "$value": "#8b95a3",                       "$type": "color", "$description": "Tertiary text — meta, captions, eyebrows." },
    "paprika":   { "$value": "#d2543b",                       "$type": "color", "$description": "Editorial accent — links, emphasis, active state." },
    "olive":     { "$value": "#5d6e44",                       "$type": "color", "$description": "Secondary accent + kitchen-mode primary." },
    "rule":      { "$value": "rgba(250, 248, 244, 0.08)",     "$type": "color", "$description": "Hairlines, borders." }
  },
  "font": {
    "display":   { "$value": "Fraunces Variable, Georgia, serif",                                                       "$type": "fontFamily", "$description": "Display face — headings, dish titles." },
    "body":      { "$value": "Inter Variable, -apple-system, BlinkMacSystemFont, Segoe UI, system-ui, sans-serif",     "$type": "fontFamily", "$description": "Body face — prose, UI, meta." }
  },
  "text": {
    "xs":        { "$value": "0.78rem",                       "$type": "dimension", "$description": "Eyebrows, kbd, meta caption." },
    "sm":        { "$value": "0.92rem",                       "$type": "dimension", "$description": "Tag chip text, dense list meta." },
    "base":      { "$value": "1rem",                          "$type": "dimension", "$description": "Body prose." },
    "md":        { "$value": "1.15rem",                       "$type": "dimension", "$description": "Lead, large lead-in list item." },
    "lg":        { "$value": "1.4rem",                        "$type": "dimension", "$description": "Sub-section title (h3)." },
    "xl":        { "$value": "clamp(1.7rem, 3.5vw, 2.6rem)",  "$type": "dimension", "$description": "Section head (h2). Viewport-fluid." },
    "2xl":       { "$value": "clamp(2.4rem, 5.5vw, 4.4rem)",  "$type": "dimension", "$description": "Page hero (h1). Viewport-fluid." }
  },
  "leading": {
    "tight":     { "$value": 1.04, "$type": "number", "$description": "Pairs with --text-2xl." },
    "display":   { "$value": 1.18, "$type": "number", "$description": "Pairs with --text-xl." },
    "snug":      { "$value": 1.3,  "$type": "number", "$description": "Pairs with --text-lg / --text-md." },
    "body":      { "$value": 1.55, "$type": "number", "$description": "Pairs with --text-base." },
    "relaxed":   { "$value": 1.7,  "$type": "number", "$description": "Lead paragraphs." }
  },
  "space": {
    "3xs":       { "$value": "0.15rem", "$type": "dimension" },
    "2xs":       { "$value": "0.3rem",  "$type": "dimension" },
    "xs":        { "$value": "0.5rem",  "$type": "dimension" },
    "sm":        { "$value": "0.8rem",  "$type": "dimension" },
    "md":        { "$value": "1.2rem",  "$type": "dimension" },
    "lg":        { "$value": "1.8rem",  "$type": "dimension" },
    "xl":        { "$value": "2.5rem",  "$type": "dimension" },
    "2xl":       { "$value": "4rem",    "$type": "dimension" },
    "3xl":       { "$value": "6rem",    "$type": "dimension" }
  },
  "radius": {
    "pill":      { "$value": "999px", "$type": "dimension", "$description": "Chips, tag clouds, search bar." },
    "card":      { "$value": "4px",   "$type": "dimension", "$description": "Cards, tiles, hero photo, banners." },
    "pop":       { "$value": "6px",   "$type": "dimension", "$description": "Popups, search results, leaflet overrides." }
  },
  "layout": {
    "measure":   { "$value": "68ch",                       "$type": "dimension", "$description": "Paragraph max-width." },
    "gutter":    { "$value": "clamp(1rem, 4vw, 2.5rem)",   "$type": "dimension", "$description": "Page-edge horizontal gutter. Viewport-fluid." }
  }
}
