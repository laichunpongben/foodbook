---
/**
 * CookSection — where heat enters.
 *
 * The recipe(s) used to assemble the dish. Card pattern.
 */

import Card from './Card.astro';
import type { JourneyCookNode } from '~/lib/journey';

interface Props {
  recipes: JourneyCookNode[];
}

const { recipes } = Astro.props;
---

<section id="cook" class="journey-section section-cook">
  <div class="container">
    <header class="section-head">
      <p class="stage-eyebrow">3 · Cook</p>
      <h2>
        Then, the kitchen.
      </h2>
      <p class="section-lead">
        Heat, time, salt, fat, acid — the recipe that turns the
        ingredients into something more than their sum.
      </p>
    </header>

    <ul class="recipes-grid">
      {recipes.map((r) => (
        <li>
          <Card
            href={`/recipes/${r.slug}/`}
            imageUrl={r.heroUrl}
            kindLabel="Recipe"
            label={r.label}
            meta={r.meta}
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ADR-0010 stage-2 migration. 1 of 2 spacing literals matched
   * (padding: 6rem → --space-3xl). The grid gap (1rem) sits between
   * --space-sm (0.8) and --space-md (1.2); kept as a literal with the
   * off-scale: marker so audit-tokens.mjs sees it as pre-audited. */
  .section-cook {
    position: relative;
    padding: var(--space-3xl) 0;
    background: linear-gradient(180deg, rgba(10, 13, 17, 1) 0%, rgba(28, 18, 14, 1) 50%, rgba(10, 13, 17, 1) 100%);
  }

  .recipes-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;                       /* off-scale: between --space-sm (0.8) and --space-md (1.2) */
    max-width: 720px;
  }
  .recipes-grid li { display: flex; }
</style>
