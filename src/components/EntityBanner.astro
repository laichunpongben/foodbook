---
/**
 * EntityBanner — full-bleed hero on entry pages. Always the LCP element,
 * so the inner image is eager + high-priority by default.
 */
import WikiImage from '~/components/WikiImage.astro';

interface Props {
  url: string;
  alt: string;
}

const { url, alt } = Astro.props;
---

<div class="entity-banner">
  <WikiImage url={url} alt={alt} loading="eager" fetchpriority="high" sizes="100vw" />
  <div class="banner-scrim" aria-hidden="true"></div>
  <div class="banner-grain" aria-hidden="true"></div>
</div>

<style>
  .entity-banner {
    position: relative;
    height: 38vh;
    min-height: 240px;
    background-color: #0a0d11;
    overflow: hidden;
  }
  .entity-banner img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .banner-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 13, 17, 0.25) 0%, rgba(10, 13, 17, 0.9) 100%);
  }
  /* Film-grain overlay — matches the homepage/hero treatment (PR #329)
   * for visual consistency across all hero photographs. 2026 "Imperfect
   * by Design" trend. 6% opacity, overlay blend. */
  .banner-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/></svg>");
    opacity: 0.06;
    mix-blend-mode: overlay;
  }
  @media (prefers-reduced-motion: reduce) {
    .banner-grain { display: none; }
  }
</style>
