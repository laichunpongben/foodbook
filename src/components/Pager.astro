---
/**
 * Pager — prev/next navigation at the bottom of an entity-detail page.
 *
 * Renders one or two links. If only `prev` or only `next` is given,
 * the other side collapses and the single link aligns to the
 * appropriate edge. If neither is given, renders nothing.
 *
 * Titles may contain authored `<em>` (same trust boundary as
 * AppearsIn / index pages) so `title` is set via `set:html`.
 */

interface PagerLink {
  href: string;
  title: string;
}

interface Props {
  prev?: PagerLink | null;
  next?: PagerLink | null;
  ariaLabel?: string;
}

const { prev, next, ariaLabel = 'Pagination' } = Astro.props;
---

{(prev || next) && (
  <nav class="pager" aria-label={ariaLabel}>
    {prev && (
      <a class="pager-link prev" href={prev.href} rel="prev">
        <span class="pager-eyebrow">Previous</span>
        <span class="pager-title" set:html={prev.title} />
      </a>
    )}
    {next && (
      <a class="pager-link next" href={next.href} rel="next">
        <span class="pager-eyebrow">Next</span>
        <span class="pager-title" set:html={next.title} />
      </a>
    )}
  </nav>
)}

<style>
  /* ADR-0010 stage-2 partial migration. One literal matched the scale
   * exactly (margin-top 4rem → --space-2xl). The other five sit between
   * scale steps; each carries an /* off-scale: */ comment naming the
   * nearest token so audit-tokens.mjs can later surface them. */
  .pager {
    display: flex;
    gap: 1.5rem;                    /* off-scale: between --space-md (1.2) and --space-lg (1.8) */
    margin-top: var(--space-2xl);
    padding-top: 2rem;              /* off-scale: between --space-lg (1.8) and --space-xl (2.5) */
    border-top: 1px solid var(--rule);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;                    /* off-scale: between --space-3xs (0.15) and --space-2xs (0.3) */
    text-decoration: none;
    color: var(--ink);
    max-width: 18rem;
  }
  .pager-link.next { margin-left: auto; text-align: right; align-items: flex-end; }
  .pager-link:hover .pager-title { color: var(--paprika); }
  .pager-eyebrow {
    font-size: 0.72rem;             /* off-scale: below --text-xs (0.78), genuinely small caps eyebrow */
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .pager-title {
    font-family: var(--font-display);
    font-size: 1.1rem;              /* off-scale: between --text-sm (0.92) and --text-md (1.15) */
  }
</style>
