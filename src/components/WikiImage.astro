---
/**
 * WikiImage — responsive <img> for Wikimedia Commons URLs.
 *
 * Builds a width-keyed `srcset` so cards/heroes request a sensibly-sized
 * thumbnail rather than the raw multi-megapixel source. URL-shape logic
 * lives in `~/lib/wiki-thumb` (tested there). For non-Commons URLs the
 * renderer emits a single <img> without srcset.
 */

import { commonsThumbBuilder } from '~/lib/wiki-thumb';

interface Props {
  url: string;
  alt: string;
  /** Set `eager` on the LCP image (hero/entity-banner); default `lazy`. */
  loading?: 'eager' | 'lazy';
  /** Use `high` only on the LCP image; default `auto`. */
  fetchpriority?: 'high' | 'auto';
  /** Display-size hint for srcset; ignored when srcset is absent. */
  sizes?: string;
  class?: string;
  style?: string;
}

const {
  url,
  alt,
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes = '100vw',
  class: className,
  style,
} = Astro.props;

const WIDTHS = [480, 768, 1280, 1920, 2560] as const;
/** Mobile-first base width — keeps phones from grabbing the largest fallback. */
const BASE_WIDTH = 768;

const builder = commonsThumbBuilder(url);
const srcset = builder ? WIDTHS.map((w) => `${builder(w)} ${w}w`).join(', ') : undefined;
const baseSrc = builder ? builder(BASE_WIDTH) : url;
---

<img
  src={baseSrc}
  srcset={srcset}
  sizes={srcset ? sizes : undefined}
  alt={alt}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  class={className}
  style={style}
/>
