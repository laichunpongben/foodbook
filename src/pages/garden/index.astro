---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const entries = publicOnly(await getCollection('garden')).sort((a, b) =>
  b.data.planted.localeCompare(a.data.planted),
);
const description = `${entries.length} garden beds tracked.`;
const section = { label: 'Garden', kind: 'garden' };
const items = entries.map((g) => ({
  name: g.data.plant,
  url: entryUrl(Astro.site!, 'garden', bare(g.id)),
}));
const ld = collectionPage(Astro.site!, { ...section, description }, items);
const crumb = breadcrumb(Astro.site!, section);
---

<BaseLayout title="Garden" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Grow</p>
    <h1>Garden</h1>
    <p class="lead">
      {entries.length} {entries.length === 1 ? 'bed' : 'beds'} tracked — what grew where, when it was planted, when it was harvested.
    </p>

    <ul class="index-list divided">
      {entries.map((g) => (
        <li>
          <a href={`/garden/${bare(g.id)}/`}>{g.data.plant}</a>
          <span class="meta">
            {g.data.bed} · planted {g.data.planted}
            {g.data.harvested && <> · harvested {g.data.harvested}</>}
          </span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .divided li { padding-bottom: 0.8rem; border-bottom: 1px solid var(--rule); }
</style>
