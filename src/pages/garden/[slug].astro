---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AppearsIn from '~/components/AppearsIn.astro';
import EntityBanner from '~/components/EntityBanner.astro';
import Pager from '~/components/Pager.astro';
import { dishesReferencing } from '~/lib/back-refs';
import { siblingsOf } from '~/lib/siblings';
import { bare } from '~/lib/slug';

export async function getStaticPaths() {
  const beds = await getCollection('garden');
  return beds.map((g) => ({
    params: { slug: bare(g.id) },
    props: { bed: g },
  }));
}

const { bed } = Astro.props;
const slug = bare(bed.id);
const { Content } = await render(bed);
const dishes = await dishesReferencing('garden', slug);
const d = bed.data;

const { prev, next } = await siblingsOf('garden', bed.id, (g) => g.data.planted, 'desc');
---

<BaseLayout
  title={`${d.plant} · ${d.bed}`}
  description={`Garden log: ${d.plant}`}
  unlisted={d.visibility === 'unlisted'}
  heroUrl={d.heroUrl}
  ogType="article"
>
  {d.heroUrl && <EntityBanner url={d.heroUrl} alt={`${d.plant} in ${d.bed}`} />}
  <article class="entity container">
    <a class="back" href="/">← Dishes</a>

    <p class="eyebrow">Grow · {d.bed}</p>
    <h1>{d.plant}</h1>
    <p class="lead">
      Planted <strong>{d.planted}</strong>
      {d.harvested && <> · harvested <strong>{d.harvested}</strong></>}
    </p>

    {d.yieldNote && <p><strong>Yield:</strong> {d.yieldNote}</p>}
    {d.note && <p set:html={d.note} />}

    <Content />

    <AppearsIn dishes={dishes} label="Used in" />

    <Pager
      ariaLabel="Other garden beds"
      prev={prev ? { href: `/garden/${bare(prev.id)}/`, title: prev.data.plant } : null}
      next={next ? { href: `/garden/${bare(next.id)}/`, title: next.data.plant } : null}
    />
  </article>
</BaseLayout>

<style>
  .entity { padding: 3rem 0 6rem; max-width: 760px; }
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--ink-mute);
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }
  .back:hover { color: var(--paprika); }
</style>
