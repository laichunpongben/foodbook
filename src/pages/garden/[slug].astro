---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AppearsIn from '~/components/AppearsIn.astro';
import EntityBanner from '~/components/EntityBanner.astro';
import JsonLd from '~/components/JsonLd.astro';
import Pager from '~/components/Pager.astro';
import { dishesReferencing } from '~/lib/back-refs';
import { SCHEMA_CTX, breadcrumb, entryUrl } from '~/lib/jsonld';
import { siblingsOf } from '~/lib/siblings';
import { bare } from '~/lib/slug';

export async function getStaticPaths() {
  const beds = await getCollection('garden');
  return beds.map((g) => ({
    params: { slug: bare(g.id) },
    props: { bed: g },
  }));
}

const { bed } = Astro.props;
const slug = bare(bed.id);
const { Content } = await render(bed);
const dishes = await dishesReferencing('garden', slug);
const d = bed.data;

const { prev, next } = await siblingsOf('garden', bed.id, (g) => g.data.planted, 'desc');

// Days from planting → harvest (or → today if still in the ground).
const MS_PER_DAY = 86_400_000;
const plantedDate = new Date(d.planted);
const endDate = d.harvested ? new Date(d.harvested) : new Date();
const daysInGround = Math.max(0, Math.round((endDate.getTime() - plantedDate.getTime()) / MS_PER_DAY));
const daysLabel = d.harvested
  ? `${daysInGround} days from planting to harvest`
  : `${daysInGround} days in the ground (still growing)`;

const site = Astro.site!;
const gardenUrl = entryUrl(site, 'garden', slug);
const gardenLd = {
  '@context': SCHEMA_CTX,
  '@type': 'Article',
  headline: `${d.plant} · ${d.bed}`,
  url: gardenUrl,
  inLanguage: 'en',
  about: d.plant,
  datePublished: d.planted,
  ...(d.harvested && { dateModified: d.harvested }),
  ...(d.heroUrl && { image: d.heroUrl }),
};
const breadcrumbLd = breadcrumb(site, { label: 'Garden', kind: 'garden' }, { label: d.plant, url: gardenUrl });
---

<BaseLayout
  title={`${d.plant} · ${d.bed}`}
  description={`Garden log: ${d.plant}`}
  unlisted={d.visibility === 'unlisted'}
  heroUrl={d.heroUrl}
  ogType="article"
  articlePublishedTime={d.planted}
  articleModifiedTime={d.harvested}
  articleSection="Garden"
>
  <JsonLd data={gardenLd} />
  <JsonLd data={breadcrumbLd} />
  {d.heroUrl && <EntityBanner url={d.heroUrl} alt={`${d.plant} in ${d.bed}`} />}
  <article class="entity container">
    <a class="back" href="/garden/">← Garden</a>

    <p class="eyebrow">Grow · {d.bed}</p>
    <h1>{d.plant}</h1>
    <p class="lead">
      Planted <strong>{d.planted}</strong>
      {d.harvested && <> · harvested <strong>{d.harvested}</strong></>}
    </p>
    <p class="stage-eyebrow garden-days">{daysLabel}</p>

    {d.yieldNote && <p><strong>Yield:</strong> {d.yieldNote}</p>}
    {d.note && <p set:html={d.note} />}

    <Content />

    <AppearsIn dishes={dishes} label="Used in" />

    <Pager
      ariaLabel="Other garden beds"
      prev={prev ? { href: `/garden/${bare(prev.id)}/`, title: prev.data.plant } : null}
      next={next ? { href: `/garden/${bare(next.id)}/`, title: next.data.plant } : null}
    />
  </article>
</BaseLayout>

<style>
  .garden-days { margin-top: 0.8rem; }
</style>
