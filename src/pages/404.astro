---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SearchBar from '~/components/SearchBar.astro';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const recent = publicOnly(await getCollection('dishes'))
  .sort((a, b) => (b.data.firstMade ?? '').localeCompare(a.data.firstMade ?? ''))
  .slice(0, 6);
---

<BaseLayout title="Not found" description="No such page in this archive.">
  <section class="not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lead">
      The page you were looking for isn't in the archive. The slug may be wrong, the entry may
      have been removed, or the page may not exist yet. Try a search:
    </p>
    <SearchBar />
    <ul class="not-found-nav">
      <li><a href="/">Home</a></li>
      <li><a href="/dishes/">Dishes</a></li>
      <li><a href="/recipes/">Recipes</a></li>
      <li><a href="/world/">World</a></li>
      <li><a href="/seasons/">Seasons</a></li>
      <li><a href="/pantry/">Pantry</a></li>
    </ul>
    {recent.length > 0 && (
      <div class="recent">
        <p class="eyebrow">Recent dishes</p>
        <ul>
          {recent.map((d) => (
            <li>
              <a href={`/dishes/${bare(d.id)}/`} set:html={d.data.title} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: 36rem;
    margin: 6rem auto;
    padding: 0 1.5rem;
    text-align: center;
  }
  .not-found .eyebrow {
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 0.5rem;
  }
  .not-found h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1.25rem;
  }
  .not-found .lead {
    color: var(--ink-soft);
    margin: 0 0 2rem;
  }
  .not-found-nav {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin: 0;
  }
  .not-found-nav a {
    color: var(--paprika);
  }
  .recent {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .recent ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .recent a {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }
</style>
