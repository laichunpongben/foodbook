---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import DishCard from '~/components/DishCard.astro';
import JsonLd from '~/components/JsonLd.astro';
import SearchBar from '~/components/SearchBar.astro';
import { SCHEMA_CTX, SITE_NAME } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const allDishes = await getCollection('dishes');
const dishes = publicOnly(allDishes).sort((a, b) => {
  const ad = a.data.firstMade ?? '0000-00-00';
  const bd = b.data.firstMade ?? '0000-00-00';
  return bd.localeCompare(ad);
});

// Pick a hero dish — the most recent, with a hero photo.
const heroDish = dishes[0];

const site = Astro.site!;
const websiteLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebSite',
  name: SITE_NAME,
  url: site.toString(),
  description: 'An archive of the food lifecycle — farms, gardens, kitchens, restaurants.',
  inLanguage: 'en',
};
---

<BaseLayout
  title="Foodbook"
  description="An archive of the food lifecycle — farms, gardens, kitchens, restaurants."
>
  <JsonLd data={websiteLd} />
  <section class="hero">
    {heroDish && (
      <div
        class="hero-photo"
        style={`background-image: url('${heroDish.data.heroUrl ?? `${heroDish.data.hero}-2560.jpg`}')`}
      />
    )}
    <div class="container">
      <p class="eyebrow">An archive of the food lifecycle</p>
      <h1 set:html={heroDish?.data.title ?? 'Source. Grow. Cook. Eat.'} />
      <p class="lead">
        Foodbook follows a dish (or an ingredient) through up to four lifecycle stages —
        the farm that grew it, the garden that nurtured it, the kitchen that cooked it,
        the meal where it landed. Each entry weaves them together.
      </p>
      <SearchBar />
      <p class="hero-cta">
        <a href="/dishes/">Browse all dishes →</a>
      </p>
    </div>
    <a href="#main-grid" class="home-scroll-indicator" aria-label="Scroll to recent dishes">
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <section class="container" id="main-grid">
    <h2>Recent dishes</h2>
    {dishes.length === 0 && (
      <p class="lead">No dish entries yet — try <code>./scripts/new-dish.sh &lt;slug&gt;</code> to scaffold one.</p>
    )}
    <div class="dish-grid">
      {dishes.map((dish) => (
        <DishCard
          slug={bare(dish.id)}
          title={dish.data.title}
          tagline={dish.data.tagline}
          hero={dish.data.hero}
          heroUrl={dish.data.heroUrl}
          heroFocal={dish.data.heroFocal}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .home-scroll-indicator {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    color: var(--ink-soft);
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    background: rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(4px);
    transition: transform 0.3s ease, border-color 0.3s ease;
    animation: home-scroll-bob 2.4s ease-in-out infinite;
    z-index: 2;
  }
  .home-scroll-indicator:hover {
    transform: translateX(-50%) scale(1.1);
    border-color: var(--paprika);
  }
  @keyframes home-scroll-bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(4px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-scroll-indicator { animation: none; }
  }
</style>
