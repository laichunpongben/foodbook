---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import DishCard from '~/components/DishCard.astro';
import JsonLd from '~/components/JsonLd.astro';
import SearchBar from '~/components/SearchBar.astro';
import { SCHEMA_CTX, SITE_NAME } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const allDishes = await getCollection('dishes');
const dishes = publicOnly(allDishes).sort((a, b) => {
  const ad = a.data.firstMade ?? '0000-00-00';
  const bd = b.data.firstMade ?? '0000-00-00';
  return bd.localeCompare(ad);
});

// Pick a hero dish — the most recent, with a hero photo.
const heroDish = dishes[0];

const site = Astro.site!;
const websiteLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebSite',
  name: SITE_NAME,
  url: site.toString(),
  description: 'An archive of the food lifecycle — farms, gardens, kitchens, restaurants.',
  inLanguage: 'en',
};
---

<BaseLayout
  title="Foodbook"
  description="An archive of the food lifecycle — farms, gardens, kitchens, restaurants."
>
  <JsonLd data={websiteLd} />
  <section class="hero">
    {heroDish && (
      <div
        class="hero-photo"
        style={`background-image: url('${heroDish.data.heroUrl ?? `${heroDish.data.hero}-2560.jpg`}')`}
      />
    )}
    <div class="container">
      <p class="eyebrow">An archive of the food lifecycle</p>
      <h1 set:html={heroDish?.data.title ?? 'Source. Grow. Cook. Eat.'} />
      <p class="lead">
        Foodbook follows a dish (or an ingredient) through up to four lifecycle stages —
        the farm that grew it, the garden that nurtured it, the kitchen that cooked it,
        the meal where it landed. Each entry weaves them together.
      </p>
      <SearchBar />
      <p class="hero-cta">
        <a href="/dishes/">Browse all dishes →</a>
      </p>
    </div>
  </section>

  <section class="container recently-viewed" data-recently-viewed hidden>
    <h2>Recently viewed</h2>
    <ul class="recently-viewed-list" data-recently-viewed-list></ul>
  </section>

  <section class="container">
    <h2>Recent dishes</h2>
    {dishes.length === 0 && (
      <p class="lead">No dish entries yet — try <code>./scripts/new-dish.sh &lt;slug&gt;</code> to scaffold one.</p>
    )}
    <div class="dish-grid">
      {dishes.map((dish) => (
        <DishCard
          slug={bare(dish.id)}
          title={dish.data.title}
          tagline={dish.data.tagline}
          hero={dish.data.hero}
          heroUrl={dish.data.heroUrl}
          heroFocal={dish.data.heroFocal}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // Populate the "Recently viewed" rail from localStorage. Server-rendered
  // section is hidden by default; this script reveals it when there's at
  // least one entry. Matches the tracker in BaseLayout.astro.
  (function() {
    try {
      const KEY = 'fb:recent-dishes';
      const raw = localStorage.getItem(KEY);
      if (!raw) return;
      const list = JSON.parse(raw) as Array<{ slug: string; title: string }>;
      if (!Array.isArray(list) || list.length === 0) return;
      const root = document.querySelector<HTMLElement>('[data-recently-viewed]');
      const ul = document.querySelector<HTMLUListElement>('[data-recently-viewed-list]');
      if (!root || !ul) return;
      for (const item of list) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/dishes/${item.slug}/`;
        a.innerHTML = item.title; // titles may include <em>
        li.appendChild(a);
        ul.appendChild(li);
      }
      root.hidden = false;
    } catch { /* non-fatal */ }
  })();
</script>

<style>
  .recently-viewed { margin: 2rem auto 3rem; }
  .recently-viewed-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .recently-viewed-list li { padding: 0; max-width: none; }
  .recently-viewed-list a {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.95rem;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .recently-viewed-list a:hover {
    border-color: var(--paprika);
    color: var(--paprika);
  }
</style>
