---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import DishCard from '~/components/DishCard.astro';
import JsonLd from '~/components/JsonLd.astro';
import SearchBar from '~/components/SearchBar.astro';
import { SCHEMA_CTX, SITE_NAME } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const allDishes = await getCollection('dishes');
const dishes = publicOnly(allDishes).sort((a, b) => {
  const ad = a.data.firstMade ?? '0000-00-00';
  const bd = b.data.firstMade ?? '0000-00-00';
  return bd.localeCompare(ad);
});

// Hero = today's pick, rotated deterministically by day-of-year. Same
// dish for everyone today; rotates at midnight UTC. Mirrors the /today
// route logic and pulls return-visit stickiness onto the homepage —
// per stickiness research, the homepage is where readers anchor.
const todayDishes = publicOnly(allDishes).sort((a, b) => bare(a.id).localeCompare(bare(b.id)));
const now = new Date();
const startOfYear = Date.UTC(now.getUTCFullYear(), 0, 0);
const dayOfYear = Math.floor((Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()) - startOfYear) / 86_400_000);
const heroDish = todayDishes.length > 0 ? todayDishes[dayOfYear % todayDishes.length] : null;

const site = Astro.site!;
const websiteLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebSite',
  name: SITE_NAME,
  url: site.toString(),
  description: 'An archive of the food lifecycle — farms, gardens, kitchens, restaurants.',
  inLanguage: 'en',
};
---

<BaseLayout
  title="Foodbook"
  description="An archive of the food lifecycle — farms, gardens, kitchens, restaurants."
>
  <JsonLd data={websiteLd} />
  <section class="hero">
    {heroDish && (
      <div
        class="hero-photo"
        style={`background-image: url('${heroDish.data.heroUrl ?? `${heroDish.data.hero}-2560.jpg`}')`}
      />
    )}
    <div class="container">
      <p class="eyebrow"><a href="/today/" class="today-link">Today’s pick</a> · {now.toLocaleDateString('en', { month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>
      {heroDish ? (
        <a href={`/dishes/${bare(heroDish.id)}/`} class="hero-title-link">
          <h1 set:html={heroDish.data.title} />
        </a>
      ) : (
        <h1>Source. Grow. Cook. Eat.</h1>
      )}
      {heroDish?.data.tagline ? (
        <p class="lead" set:html={heroDish.data.tagline} />
      ) : (
        <p class="lead">
          Foodbook follows a dish (or an ingredient) through up to four lifecycle stages —
          the farm that grew it, the garden that nurtured it, the kitchen that cooked it,
          the meal where it landed. Each entry weaves them together.
        </p>
      )}
      <SearchBar />
      <p class="hero-cta">
        <a href="/dishes/">Browse all {dishes.length} dishes →</a>
      </p>
    </div>
  </section>

  <section class="container">
    <h2>Recently added</h2>
    <p class="recently-lead">Latest dishes joining the archive — the index changes each time a new one lands. <a href="/today/">Today's pick</a> rotates every midnight UTC.</p>
    {dishes.length === 0 && (
      <p class="lead">No dish entries yet — try <code>./scripts/new-dish.sh &lt;slug&gt;</code> to scaffold one.</p>
    )}
    <div class="dish-grid">
      {dishes.map((dish) => (
        <DishCard
          slug={bare(dish.id)}
          title={dish.data.title}
          tagline={dish.data.tagline}
          hero={dish.data.hero}
          heroUrl={dish.data.heroUrl}
          heroFocal={dish.data.heroFocal}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .today-link {
    color: var(--paprika);
    text-decoration: none;
    border-bottom: 1px dotted var(--paprika);
  }
  .today-link:hover { color: var(--ink); border-color: var(--ink); }
  .hero-title-link {
    text-decoration: none;
    color: inherit;
    display: inline-block;
  }
  .hero-title-link h1 { transition: color 0.2s ease; }
  .hero-title-link:hover h1 { color: var(--paprika); }
  .recently-lead {
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
    max-width: 60ch;
  }
</style>
