---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import DishCard from '~/components/DishCard.astro';
import JsonLd from '~/components/JsonLd.astro';
import SearchBar from '~/components/SearchBar.astro';
import { SCHEMA_CTX, SITE_NAME } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const allDishes = await getCollection('dishes');
const dishes = publicOnly(allDishes).sort((a, b) => {
  const ad = a.data.firstMade ?? '0000-00-00';
  const bd = b.data.firstMade ?? '0000-00-00';
  return bd.localeCompare(ad);
});

// Pick a hero dish — the most recent, with a hero photo.
const heroDish = dishes[0];

const site = Astro.site!;
const websiteLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebSite',
  name: SITE_NAME,
  url: site.toString(),
  description: 'An archive of the food lifecycle — farms, gardens, kitchens, restaurants.',
  inLanguage: 'en',
};
---

<BaseLayout
  title="Foodbook"
  description="An archive of the food lifecycle — farms, gardens, kitchens, restaurants."
>
  <JsonLd data={websiteLd} />
  <section class="hero">
    {heroDish && (
      <div
        class="hero-photo"
        style={`background-image: url('${heroDish.data.heroUrl ?? `${heroDish.data.hero}-2560.jpg`}')`}
      />
    )}
    <div class="container">
      <p class="eyebrow">An archive of the food lifecycle</p>
      {heroDish ? (
        <a class="hero-title-link" href={`/dishes/${bare(heroDish.id)}/`} aria-label={`Read about ${heroDish.data.shortTitle}`}>
          <h1 set:html={heroDish.data.title} />
        </a>
      ) : (
        <h1>Source. Grow. Cook. Eat.</h1>
      )}
      <p class="lead">
        Foodbook follows a dish (or an ingredient) through up to four lifecycle stages —
        the farm that grew it, the garden that nurtured it, the kitchen that cooked it,
        the meal where it landed. Each entry weaves them together.
      </p>
      <SearchBar />
      <p class="hero-cta">
        <a href="/dishes/">Browse all dishes →</a>
      </p>
    </div>
  </section>

  <section class="container">
    <h2>Recent dishes</h2>
    {dishes.length === 0 && (
      <p class="lead">No dish entries yet — try <code>./scripts/new-dish.sh &lt;slug&gt;</code> to scaffold one.</p>
    )}
    <div class="dish-grid">
      {dishes.map((dish) => (
        <DishCard
          slug={bare(dish.id)}
          title={dish.data.title}
          tagline={dish.data.tagline}
          hero={dish.data.hero}
          heroUrl={dish.data.heroUrl}
          heroFocal={dish.data.heroFocal}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero-title-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: color 0.15s ease;
  }
  .hero-title-link h1 {
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .hero-title-link:hover h1 {
    color: var(--paprika);
  }
</style>
