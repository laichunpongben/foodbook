---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import DishCard from '~/components/DishCard.astro';
import JsonLd from '~/components/JsonLd.astro';
import SearchBar from '~/components/SearchBar.astro';
import { SCHEMA_CTX, SITE_NAME } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const allDishes = await getCollection('dishes');
const dishes = publicOnly(allDishes).sort((a, b) => {
  const ad = a.data.firstMade ?? '0000-00-00';
  const bd = b.data.firstMade ?? '0000-00-00';
  return bd.localeCompare(ad);
});

// Pick a hero dish — the most recent, with a hero photo.
const heroDish = dishes[0];

const site = Astro.site!;
const websiteLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebSite',
  name: SITE_NAME,
  url: site.toString(),
  description: 'An archive of the food lifecycle — farms, gardens, kitchens, restaurants.',
  inLanguage: 'en',
};
---

<BaseLayout
  title="Foodbook"
  description="An archive of the food lifecycle — farms, gardens, kitchens, restaurants."
>
  <JsonLd data={websiteLd} />
  <section class="hero">
    {heroDish && (
      <div
        class="hero-photo"
        style={`background-image: url('${heroDish.data.heroUrl ?? `${heroDish.data.hero}-2560.jpg`}')`}
      />
    )}
    <div class="container">
      <p class="eyebrow">An archive of the food lifecycle</p>
      <h1 set:html={heroDish?.data.title ?? 'Source. Grow. Cook. Eat.'} />
      <p class="lead">
        Foodbook follows a dish (or an ingredient) through up to four lifecycle stages —
        the farm that grew it, the garden that nurtured it, the kitchen that cooked it,
        the meal where it landed. Each entry weaves them together.
      </p>
      <SearchBar />
      <p class="hero-cta">
        <a href="/dishes/">Browse all dishes →</a>
      </p>
    </div>
  </section>

  <section class="container lifecycle-explainer" aria-label="The four stages">
    <p class="lifecycle-eyebrow">The four stages</p>
    <ul class="lifecycle-stages">
      <li>
        <span class="stage-num">1</span>
        <a href="/world/">
          <span class="stage-name">Source</span>
          <span class="stage-desc">Farm, market, fishmonger.</span>
        </a>
      </li>
      <li>
        <span class="stage-num">2</span>
        <a href="/grow/">
          <span class="stage-name">Grow</span>
          <span class="stage-desc">Garden, balcony, forage.</span>
        </a>
      </li>
      <li>
        <span class="stage-num">3</span>
        <a href="/recipes/">
          <span class="stage-name">Cook</span>
          <span class="stage-desc">Recipe, technique, time.</span>
        </a>
      </li>
      <li>
        <span class="stage-num">4</span>
        <a href="/eat-out/">
          <span class="stage-name">Eat</span>
          <span class="stage-desc">Home meal, restaurant.</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="container">
    <h2>Recent dishes</h2>
    {dishes.length === 0 && (
      <p class="lead">No dish entries yet — try <code>./scripts/new-dish.sh &lt;slug&gt;</code> to scaffold one.</p>
    )}
    <div class="dish-grid">
      {dishes.map((dish) => (
        <DishCard
          slug={bare(dish.id)}
          title={dish.data.title}
          tagline={dish.data.tagline}
          hero={dish.data.hero}
          heroUrl={dish.data.heroUrl}
          heroFocal={dish.data.heroFocal}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .lifecycle-explainer {
    margin: 2.5rem auto;
    padding: 1.6rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .lifecycle-eyebrow {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paprika);
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .lifecycle-stages {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
  }
  .lifecycle-stages li {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    max-width: none;
  }
  .stage-num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--paprika);
    line-height: 1;
    min-width: 1.6em;
  }
  .lifecycle-stages a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--ink);
  }
  .stage-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .lifecycle-stages a:hover .stage-name { color: var(--paprika); }
  .stage-desc {
    color: var(--ink-mute);
    font-size: 0.88rem;
    line-height: 1.4;
  }
  @media (max-width: 720px) {
    .lifecycle-stages { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .lifecycle-stages { grid-template-columns: 1fr; }
  }
</style>
