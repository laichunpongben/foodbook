---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import DishCard from '~/components/DishCard.astro';
import JsonLd from '~/components/JsonLd.astro';
import SearchBar from '~/components/SearchBar.astro';
import { SCHEMA_CTX, SITE_NAME } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const allDishes = await getCollection('dishes');
const dishes = publicOnly(allDishes).sort((a, b) => {
  const ad = a.data.firstMade ?? '0000-00-00';
  const bd = b.data.firstMade ?? '0000-00-00';
  return bd.localeCompare(ad);
});

// Pick a hero dish — the most recent, with a hero photo.
const heroDish = dishes[0];

const site = Astro.site!;
const websiteLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebSite',
  name: SITE_NAME,
  url: site.toString(),
  description: 'An archive of the food lifecycle — farms, gardens, kitchens, restaurants.',
  inLanguage: 'en',
};
---

<BaseLayout
  title="Foodbook"
  description="An archive of the food lifecycle — farms, gardens, kitchens, restaurants."
>
  <JsonLd data={websiteLd} />
  <section class="hero">
    {heroDish && (
      <div
        class="hero-photo"
        style={`background-image: url('${heroDish.data.heroUrl ?? `${heroDish.data.hero}-2560.jpg`}')`}
      />
    )}
    <div class="container">
      <p class="eyebrow">An archive of the food lifecycle</p>
      <h1 set:html={heroDish?.data.title ?? 'Source. Grow. Cook. Eat.'} />
      <p class="lead">
        Foodbook follows a dish (or an ingredient) through up to four lifecycle stages —
        the farm that grew it, the garden that nurtured it, the kitchen that cooked it,
        the meal where it landed. Each entry weaves them together.
      </p>
      <SearchBar />
      <p class="hero-cta">
        <a href="/dishes/">Browse all dishes →</a>
      </p>
    </div>
  </section>

  <section class="container explore-rail" aria-label="More ways to explore">
    <p class="explore-eyebrow">More ways in</p>
    <ul class="explore-list">
      <li><a href="/cuisines/"><span class="explore-name">By cuisine</span><span class="explore-desc">10 traditions, photo cards</span></a></li>
      <li><a href="/techniques/"><span class="explore-name">By technique</span><span class="explore-desc">Bake, grill, ferment, raw</span></a></li>
      <li><a href="/timeline/"><span class="explore-name">By date</span><span class="explore-desc">Cooked-on timeline</span></a></li>
      <li><a href="/signature/"><span class="explore-name">Signature</span><span class="explore-desc">Fully-traced gold</span></a></li>
      <li><a href="/first-bite/"><span class="explore-name">First bite</span><span class="explore-desc">9-dish sampler</span></a></li>
      <li><a href="/atlas/"><span class="explore-name">Atlas</span><span class="explore-desc">By country</span></a></li>
    </ul>
  </section>

  <section class="container">
    <h2>Recent dishes</h2>
    {dishes.length === 0 && (
      <p class="lead">No dish entries yet — try <code>./scripts/new-dish.sh &lt;slug&gt;</code> to scaffold one.</p>
    )}
    <div class="dish-grid">
      {dishes.map((dish) => (
        <DishCard
          slug={bare(dish.id)}
          title={dish.data.title}
          tagline={dish.data.tagline}
          hero={dish.data.hero}
          heroUrl={dish.data.heroUrl}
          heroFocal={dish.data.heroFocal}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .explore-rail {
    margin: 2.5rem auto;
    padding: 1.6rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .explore-eyebrow {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paprika);
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .explore-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem 1.4rem;
  }
  .explore-list li { padding: 0; max-width: none; }
  .explore-list a {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    text-decoration: none;
    color: var(--ink);
    padding: 0.5rem 0.7rem;
    border-radius: 6px;
    transition: background 0.15s ease;
  }
  .explore-list a:hover { background: rgba(210, 84, 59, 0.07); }
  .explore-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--ink);
    transition: color 0.15s ease;
  }
  .explore-list a:hover .explore-name { color: var(--paprika); }
  .explore-desc {
    color: var(--ink-mute);
    font-size: 0.85rem;
  }
  @media (max-width: 720px) {
    .explore-list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .explore-list { grid-template-columns: 1fr; }
  }
</style>
