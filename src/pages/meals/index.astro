---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { collectionPage } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const meals = publicOnly(await getCollection('meals')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
const description = `${meals.length} meal events logged.`;
const ld = collectionPage(Astro.site!, { label: 'Meals', kind: 'meals', description }, meals.length);
---

<BaseLayout title="Meals" description={description}>
  <JsonLd data={ld} />
  <section class="container index-page">
    <p class="eyebrow">Eat</p>
    <h1>Meals</h1>
    <p class="lead">
      {meals.length} {meals.length === 1 ? 'meal' : 'meals'} logged — the moments where the lifecycle ends.
    </p>

    <ul class="index-list divided">
      {meals.map((m) => (
        <li>
          <a href={`/meals/${bare(m.id)}/`}>{m.data.title}</a>
          <span class="meta">
            {m.data.date}
            {m.data.occasion && <> · {m.data.occasion}</>}
          </span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .divided li { padding-bottom: 0.8rem; border-bottom: 1px solid var(--rule); }
</style>
