---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { dishesReferencing } from '~/lib/back-refs';
import AppearsIn from '~/components/AppearsIn.astro';
import EntityBanner from '~/components/EntityBanner.astro';
import JsonLd from '~/components/JsonLd.astro';
import Pager from '~/components/Pager.astro';
import { SCHEMA_CTX, breadcrumb, entryUrl } from '~/lib/jsonld';
import { siblingsOf } from '~/lib/siblings';
import { bare, bareSlug } from '~/lib/slug';

export async function getStaticPaths() {
  const meals = await getCollection('meals');
  return meals.map((m) => ({
    params: { slug: bare(m.id) },
    props: { meal: m },
  }));
}

const { meal } = Astro.props;
const slug = bare(meal.id);
const { Content } = await render(meal);
const dishes = await dishesReferencing('meal', slug);
const d = meal.data;

const allDishes = await getCollection('dishes');
const dishLabel = new Map(
  allDishes.map((entry) => [bareSlug(entry.id), entry.data.shortTitle ?? entry.data.title]),
);

const restaurant = d.location === 'home'
  ? null
  : (await getCollection('restaurants')).find((r) => bare(r.id) === d.location);
const locationLabel = restaurant?.data.name ?? d.location;

const { prev, next } = await siblingsOf('meals', meal.id, (m) => m.data.date, 'desc');

const site = Astro.site!;
const mealUrl = entryUrl(site, 'meals', slug);
const mealLocation = restaurant
  ? {
      '@type': 'Restaurant',
      name: restaurant.data.name,
      url: entryUrl(site, 'restaurants', bare(restaurant.id)),
      address: { '@type': 'PostalAddress', addressLocality: restaurant.data.city,
        ...(restaurant.data.country && { addressCountry: restaurant.data.country }) },
    }
  : { '@type': 'Place', name: 'Home' };
const mealLd = {
  '@context': SCHEMA_CTX,
  '@type': 'FoodEvent',
  name: d.title,
  url: mealUrl,
  startDate: d.date,
  location: mealLocation,
  inLanguage: 'en',
  ...(d.occasion && { description: d.occasion }),
  ...(d.heroUrl && { image: d.heroUrl }),
  ...(d.tags.length > 0 && { keywords: d.tags.join(', ') }),
};
const breadcrumbLd = breadcrumb(site, { label: 'Meals', kind: 'meals' }, { label: d.title, url: mealUrl });
---

<BaseLayout
  title={d.title}
  description={`Meal on ${d.date}`}
  unlisted={d.visibility === 'unlisted'}
  heroUrl={d.heroUrl}
  ogType="article"
  articleTags={d.tags}
  articlePublishedTime={d.date}
  articleSection="Meals"
>
  <JsonLd data={mealLd} />
  <JsonLd data={breadcrumbLd} />
  {d.heroUrl && <EntityBanner url={d.heroUrl} alt={`${d.title} — meal on ${d.date}`} />}
  <article class="entity container">
    <a class="back" href="/meals/">← Meals</a>

    <p class="eyebrow">Meal · {d.date}{d.occasion && ` · ${d.occasion}`}</p>
    <h1>{d.title}</h1>
    <p class="lead">
      At {d.location === 'home' ? 'home' : <a href={`/restaurants/${d.location}/`}>{locationLabel}</a>}
      {d.companionCount !== undefined && d.companionCount > 0 && <>{' · '}{d.companionCount} at the table</>}
    </p>

    {d.tags.length > 0 && (
      <ul class="tag-chips entity-tags" aria-label="Tags">
        {d.tags.map((t) => <li><a href={`/tags/${t}/`}>{t}</a></li>)}
      </ul>
    )}

    <Content />

    {d.dishes.length > 0 && (
      <section>
        <p class="eyebrow">Dishes served</p>
        <ul>
          {d.dishes.map((s) => <li><a href={`/dishes/${s}/`}>{dishLabel.get(s) ?? s}</a></li>)}
        </ul>
      </section>
    )}

    <AppearsIn dishes={dishes} label="Referenced by" />

    <Pager
      ariaLabel="Other meals"
      prev={prev ? { href: `/meals/${bare(prev.id)}/`, title: prev.data.title } : null}
      next={next ? { href: `/meals/${bare(next.id)}/`, title: next.data.title } : null}
    />
  </article>
</BaseLayout>

<style>
  section { margin-top: 2.5rem; }
  .entity-tags { margin-top: 1.2rem; }
</style>
