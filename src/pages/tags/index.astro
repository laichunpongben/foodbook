---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd from '~/components/JsonLd.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { publicOnly } from '~/lib/visibility';

const [dishes, recipes, restaurants, meals] = await Promise.all([
  getCollection('dishes').then(publicOnly),
  getCollection('recipes').then(publicOnly),
  getCollection('restaurants').then(publicOnly),
  getCollection('meals').then(publicOnly),
]);

const counts = new Map<string, number>();
const bump = (tags: readonly string[]) => {
  for (const t of tags) counts.set(t, (counts.get(t) ?? 0) + 1);
};
for (const d of dishes) bump(d.data.tags);
for (const r of recipes) bump(r.data.tags);
for (const r of restaurants) bump(r.data.tags);
for (const m of meals) bump(m.data.tags);

const tags = [...counts.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, count]) => ({ name, count }));

// Weighted-cloud: map count to a CSS class (w-1 smallest to w-5 largest).
// Classic tag-cloud pattern — most-popular tags read as large, rare ones
// stay small. Threshold tiers tuned for the current corpus distribution.
const maxCount = Math.max(1, ...tags.map((t) => t.count));
function weightClass(count: number): string {
  const ratio = count / maxCount;
  if (ratio > 0.8) return 'w-5';
  if (ratio > 0.55) return 'w-4';
  if (ratio > 0.3) return 'w-3';
  if (ratio > 0.12) return 'w-2';
  return 'w-1';
}

const site = Astro.site!;
const section = { label: 'Tags', kind: 'tags' };
const description = `${tags.length} tags across the archive.`;
const items = tags.map((t) => ({
  name: t.name,
  url: entryUrl(site, 'tags', t.name),
  description: `${t.count} ${t.count === 1 ? 'entry' : 'entries'}`,
}));
const ld = collectionPage(site, { ...section, description }, items);
const crumb = breadcrumb(site, section);
---

<BaseLayout title="Tags" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Index</p>
    <h1>Tags</h1>
    <p class="lead">{tags.length} tags in the archive, alphabetical. Each opens a list of every dish, recipe, restaurant, and meal carrying it.</p>

    <ul class="tag-cloud weighted">
      {tags.map((t) => (
        <li class={weightClass(t.count)}>
          <a href={`/tags/${t.name}/`}>{t.name}<span class="count">{t.count}</span></a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .tag-cloud { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag-cloud a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .tag-cloud a:hover { border-color: var(--paprika); color: var(--paprika); }
  .tag-cloud .count { color: var(--ink-mute); font-size: 0.78rem; }

  /* Weighted-cloud sizing — five steps from rare to popular. */
  .tag-cloud.weighted li.w-1 a { font-size: 0.82rem; padding: 0.28rem 0.7rem; }
  .tag-cloud.weighted li.w-2 a { font-size: 0.95rem; padding: 0.32rem 0.8rem; }
  .tag-cloud.weighted li.w-3 a { font-size: 1.1rem;  padding: 0.36rem 0.9rem; }
  .tag-cloud.weighted li.w-4 a { font-size: 1.3rem;  padding: 0.42rem 1rem;   color: var(--ink); }
  .tag-cloud.weighted li.w-5 a {
    font-size: 1.55rem; padding: 0.48rem 1.1rem; color: var(--ink);
    border-color: rgba(210, 84, 59, 0.4);
    font-family: var(--font-display);
  }
  .tag-cloud.weighted .count { font-size: 0.72rem; opacity: 0.6; }
</style>
