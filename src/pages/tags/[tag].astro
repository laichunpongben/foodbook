---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd from '~/components/JsonLd.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare, bareSlug } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

interface TagEntry {
  href: string;
  name: string;
  meta: string;
  kind: 'Dish' | 'Recipe' | 'Restaurant' | 'Meal';
  photo: string | null;
}

export async function getStaticPaths() {
  const [dishes, recipes, restaurants, meals] = await Promise.all([
    getCollection('dishes').then(publicOnly),
    getCollection('recipes').then(publicOnly),
    getCollection('restaurants').then(publicOnly),
    getCollection('meals').then(publicOnly),
  ]);
  const byTag = new Map<string, TagEntry[]>();
  const push = (tag: string, entry: TagEntry) => {
    const list = byTag.get(tag) ?? [];
    list.push(entry);
    byTag.set(tag, list);
  };
  for (const d of dishes) {
    const photo = d.data.heroUrl ?? (d.data.hero ? `${d.data.hero}-640.jpg` : null);
    for (const t of d.data.tags) push(t, {
      href: `/dishes/${bareSlug(d.id)}/`,
      name: d.data.shortTitle,
      meta: d.data.tagline ?? '',
      kind: 'Dish',
      photo,
    });
  }
  for (const r of recipes) {
    for (const t of r.data.tags) push(t, {
      href: `/recipes/${bare(r.id)}/`,
      name: r.data.title,
      meta: [r.data.yield, r.data.timeCook].filter(Boolean).join(' · '),
      kind: 'Recipe',
      photo: r.data.heroUrl ?? null,
    });
  }
  for (const r of restaurants) {
    for (const t of r.data.tags) push(t, {
      href: `/restaurants/${bare(r.id)}/`,
      name: r.data.name,
      meta: [r.data.cuisine, r.data.city].filter(Boolean).join(' · '),
      kind: 'Restaurant',
      photo: r.data.heroUrl ?? null,
    });
  }
  for (const m of meals) {
    for (const t of m.data.tags) push(t, {
      href: `/meals/${bare(m.id)}/`,
      name: m.data.title,
      meta: m.data.date,
      kind: 'Meal',
      photo: null,
    });
  }
  return [...byTag.entries()].map(([tag, entries]) => ({
    params: { tag },
    props: { tag, entries },
  }));
}

const { tag, entries: rawEntries } = Astro.props;
const entries = [...rawEntries].sort(
  (a, b) => a.kind.localeCompare(b.kind) || a.name.localeCompare(b.name),
);

const site = Astro.site!;
const tagUrl = entryUrl(site, 'tags', tag);
const description = `${entries.length} entries tagged ${tag}.`;
const items = entries.map((e) => ({
  name: e.name,
  url: new URL(e.href, site).toString(),
  ...(e.meta && { description: e.meta }),
}));
const ld = collectionPage(
  site,
  { label: `Tag · ${tag}`, kind: `tags/${tag}`, description },
  items,
);
const crumb = breadcrumb(site, { label: 'Tags', kind: 'tags' }, { label: tag, url: tagUrl });
---

<BaseLayout title={`Tag: ${tag}`} description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Tag</p>
    <h1>{tag}</h1>
    <p class="lead">{entries.length} {entries.length === 1 ? 'entry' : 'entries'} tagged <strong>{tag}</strong>.</p>

    <ul class="tag-list">
      {entries.map((e) => (
        <li class="tag-list-item">
          {e.photo && (
            <a class="tag-list-thumb" href={e.href} aria-hidden="true" tabindex="-1">
              <img src={e.photo} alt="" loading="lazy" decoding="async" />
            </a>
          )}
          <div class="tag-list-text">
            <a href={e.href}>{e.name}</a>
            <span class="meta">
              <span class={`tag-kind tag-kind--${e.kind.toLowerCase()}`}>{e.kind}</span>
              {e.meta && <> · {e.meta}</>}
            </span>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .tag-list {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .tag-list-item {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    max-width: none;
  }
  .tag-list-item:not(:has(.tag-list-thumb)) { grid-template-columns: 1fr; }
  .tag-list-thumb {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 6px;
    overflow: hidden;
    background: #11161c;
  }
  .tag-list-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tag-list-item:hover .tag-list-thumb img { transform: scale(1.05); }
  .tag-list-text { display: flex; flex-direction: column; gap: 0.15rem; }
  .tag-list-text > a {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .tag-list-text > a:hover { color: var(--paprika); }
  .tag-list-text .meta {
    color: var(--ink-mute);
    font-size: 0.88rem;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .tag-kind {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--ink-soft);
  }
  .tag-kind--dish { background: rgba(210, 84, 59, 0.14); color: var(--paprika); }
  .tag-kind--recipe { background: rgba(93, 110, 68, 0.2); color: rgba(141, 178, 95, 0.95); }
  .tag-kind--restaurant { background: rgba(180, 140, 60, 0.16); color: rgba(220, 180, 100, 0.95); }
  .tag-kind--meal { background: rgba(100, 130, 180, 0.16); color: rgba(140, 175, 220, 0.95); }
  @media (max-width: 480px) {
    .tag-list-item { grid-template-columns: 56px 1fr; gap: 0.8rem; }
    .tag-list-thumb { width: 56px; height: 56px; }
  }
</style>
