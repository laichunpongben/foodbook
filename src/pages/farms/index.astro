---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const farms = publicOnly(await getCollection('farms')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

// kind enum from src/content.config.ts — keep in sync until we export it from there.
const kindLabels: Record<string, string> = {
  farm: 'Farms',
  producer: 'Producers',
  orchard: 'Orchards',
  dairy: 'Dairies',
  mill: 'Mills',
  market: 'Markets',
  fishery: 'Fisheries',
  forager: 'Foragers',
};
const kindOrder = Object.keys(kindLabels);

const byKind = new Map<string, typeof farms>();
for (const f of farms) {
  const list = byKind.get(f.data.kind) ?? [];
  list.push(f);
  byKind.set(f.data.kind, list);
}
const groups = kindOrder
  .map((k) => [k, byKind.get(k) ?? []] as const)
  .filter(([, list]) => list.length > 0);

const description = `${farms.length} sources in the archive.`;
const section = { label: 'Farms & producers', kind: 'farms' };
const items = farms.map((f) => ({
  name: f.data.name,
  url: entryUrl(Astro.site!, 'farms', bare(f.id)),
  description: `${f.data.kind} · ${f.data.location}`,
}));
const ld = collectionPage(Astro.site!, { ...section, description }, items);
const crumb = breadcrumb(Astro.site!, section);
---

<BaseLayout title="Farms & producers" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Source</p>
    <h1>Farms & producers</h1>
    <p class="lead">
      {farms.length} growers, dairies, mills, and markets — the upstream side of every dish.
      See also: <a href="/world/">the map</a>.
    </p>

    {groups.map(([kind, list]) => (
      <div class="index-group">
        <h2>{kindLabels[kind]}</h2>
        <ul class="farms-list">
          {list.map((f) => (
            <li class="farms-list-item">
              {f.data.heroUrl && (
                <a class="farms-list-thumb" href={`/farms/${bare(f.id)}/`} aria-hidden="true" tabindex="-1">
                  <img src={f.data.heroUrl} alt="" loading="lazy" decoding="async" />
                </a>
              )}
              <div class="farms-list-text">
                <a href={`/farms/${bare(f.id)}/`}>{f.data.name}</a>
                <span class="meta">{f.data.location}{f.data.country && `, ${f.data.country}`}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .farms-list {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .farms-list-item {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    max-width: none;
  }
  .farms-list-thumb {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 6px;
    overflow: hidden;
    background: #11161c;
  }
  .farms-list-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .farms-list-item:hover .farms-list-thumb img { transform: scale(1.05); }
  .farms-list-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .farms-list-text a {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--ink);
    text-decoration: none;
  }
  .farms-list-text a:hover { color: var(--paprika); }
  .farms-list-text .meta {
    color: var(--ink-mute);
    font-size: 0.88rem;
  }
  @media (max-width: 480px) {
    .farms-list-item { grid-template-columns: 56px 1fr; gap: 0.8rem; }
    .farms-list-thumb { width: 56px; height: 56px; }
  }
  /* Backward-compat: keep .index-list styling for any nested usage. */
  .index-list { gap: 0.6rem; margin-top: 0.8rem; }
  .index-list a { font-size: 1.1rem; }
</style>
