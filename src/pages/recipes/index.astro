---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import SearchBar from '~/components/SearchBar.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const recipes = publicOnly(await getCollection('recipes')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const description = `${recipes.length} recipes in the archive.`;
const section = { label: 'Recipes', kind: 'recipes' };
const items = recipes.map((r) => {
  const meta = [r.data.yield, r.data.timeCook && `cook ${r.data.timeCook}`].filter(Boolean).join(' · ');
  return {
    name: r.data.title,
    url: entryUrl(Astro.site!, 'recipes', bare(r.id)),
    ...(meta && { description: meta }),
  };
});
const ld = collectionPage(Astro.site!, { ...section, description }, items);
const crumb = breadcrumb(Astro.site!, section);
---

<BaseLayout title="Recipes" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Cook</p>
    <h1>Recipes</h1>
    <p class="lead">
      {recipes.length} cookable recipes — yields, timing, and ingredient provenance.
      Each opens in <em>cook mode</em> for kitchen use.
    </p>

    <SearchBar />

    <ul class="index-list divided">
      {recipes.map((r) => (
        <li>
          <a href={`/recipes/${bare(r.id)}/`}>{r.data.title}</a>
          <span class="meta">
            {[r.data.yield, r.data.timeCook].filter(Boolean).join(' · ')}
          </span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
