---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const recipes = publicOnly(await getCollection('recipes')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const description = `${recipes.length} recipes in the archive.`;
const section = { label: 'Recipes', kind: 'recipes' };
const items = recipes.map((r) => {
  const meta = [r.data.yield, r.data.timeCook && `cook ${r.data.timeCook}`].filter(Boolean).join(' · ');
  return {
    name: r.data.title,
    url: entryUrl(Astro.site!, 'recipes', bare(r.id)),
    ...(meta && { description: meta }),
  };
});
const ld = collectionPage(Astro.site!, { ...section, description }, items);
const crumb = breadcrumb(Astro.site!, section);
---

<BaseLayout title="Recipes" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Cook</p>
    <h1>Recipes</h1>
    <p class="lead">
      Yields, timing, ingredient provenance. Each opens in <em>cook mode</em> for kitchen use.
    </p>
    <ul class="index-stats" aria-label="Recipe scope">
      <li><strong>{recipes.length}</strong> recipes</li>
      <li><strong>{recipes.filter((r) => r.data.timeCook).length}</strong> timed</li>
      <li><strong>{new Set(recipes.flatMap((r) => r.data.tags ?? [])).size}</strong> tags covered</li>
    </ul>

    <ul class="index-list divided">
      {recipes.map((r) => (
        <li>
          <a href={`/recipes/${bare(r.id)}/`}>{r.data.title}</a>
          <span class="meta">
            {[r.data.yield, r.data.timeCook].filter(Boolean).join(' · ')}
          </span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .index-stats {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--ink-mute);
    font-size: 0.92rem;
  }
  .index-stats li { padding: 0; max-width: none; }
  .index-stats strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--paprika);
    font-weight: 500;
    margin-right: 0.25rem;
  }
</style>
