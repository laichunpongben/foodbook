---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const recipes = publicOnly(await getCollection('recipes')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const description = `${recipes.length} recipes in the archive.`;
const section = { label: 'Recipes', kind: 'recipes' };
const items = recipes.map((r) => {
  const meta = [r.data.yield, r.data.timeCook && `cook ${r.data.timeCook}`].filter(Boolean).join(' · ');
  return {
    name: r.data.title,
    url: entryUrl(Astro.site!, 'recipes', bare(r.id)),
    ...(meta && { description: meta }),
  };
});
const ld = collectionPage(Astro.site!, { ...section, description }, items);
const crumb = breadcrumb(Astro.site!, section);
---

<BaseLayout title="Recipes" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Cook</p>
    <h1>Recipes</h1>
    <p class="lead">
      {recipes.length} cookable recipes — yields, timing, and ingredient provenance.
      Each opens in <em>cook mode</em> for kitchen use.
    </p>

    <ul class="recipes-list">
      {recipes.map((r) => (
        <li class="recipes-list-item">
          {r.data.heroUrl && (
            <a class="recipes-list-thumb" href={`/recipes/${bare(r.id)}/`} aria-hidden="true" tabindex="-1">
              <img src={r.data.heroUrl} alt="" loading="lazy" decoding="async" />
            </a>
          )}
          <div class="recipes-list-text">
            <a href={`/recipes/${bare(r.id)}/`}>{r.data.title}</a>
            <span class="meta">
              {[r.data.yield, r.data.timeCook].filter(Boolean).join(' · ')}
            </span>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .recipes-list {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .recipes-list-item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.2rem;
    align-items: center;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
    max-width: none;
  }
  .recipes-list-thumb {
    display: block;
    width: 88px;
    height: 88px;
    border-radius: 6px;
    overflow: hidden;
    background: #11161c;
  }
  .recipes-list-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .recipes-list-item:hover .recipes-list-thumb img { transform: scale(1.05); }
  .recipes-list-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .recipes-list-text > a {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ink);
    text-decoration: none;
  }
  .recipes-list-text > a:hover { color: var(--paprika); }
  .recipes-list-text .meta {
    color: var(--ink-mute);
    font-size: 0.88rem;
  }
  .recipes-list-item:not(:has(.recipes-list-thumb)) {
    grid-template-columns: 1fr;
  }
  @media (max-width: 480px) {
    .recipes-list-item { grid-template-columns: 60px 1fr; gap: 0.9rem; }
    .recipes-list-thumb { width: 60px; height: 60px; }
  }
</style>
