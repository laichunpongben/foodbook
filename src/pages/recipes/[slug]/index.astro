---
import { getCollection, render } from 'astro:content';
import AppearsIn from '~/components/AppearsIn.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd from '~/components/JsonLd.astro';
import Pager from '~/components/Pager.astro';
import { dishesReferencing } from '~/lib/back-refs';
import { SCHEMA_CTX, breadcrumb, entryUrl } from '~/lib/jsonld';
import { relatedByTags } from '~/lib/related';
import { siblingsOf } from '~/lib/siblings';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  const allPublic = publicOnly(recipes);
  return recipes.map((recipe) => ({
    params: { slug: bare(recipe.id) },
    props: { recipe, allPublic },
  }));
}

const { recipe, allPublic } = Astro.props;
const slug = bare(recipe.id);
const { Content } = await render(recipe);
const dishesUsingThisRecipe = publicOnly(await dishesReferencing('recipe', slug));

const { prev, next } = await siblingsOf('recipes', recipe.id, (r) => r.data.title);

const related = relatedByTags(allPublic, recipe, (r) => r.data.title);

// Resolve an ingredient's `from` slug to its farm or garden entry.
// Returns the right href and display name, or null if the slug doesn't
// resolve — the renderer then falls back to plain text.
const farms = await getCollection('farms');
const gardens = await getCollection('garden');
function findProducer(s: string): { href: string; label: string } | null {
  const farm = farms.find((f) => bare(f.id) === s);
  if (farm) return { href: `/farms/${bare(farm.id)}/`, label: farm.data.name };
  const garden = gardens.find((g) => bare(g.id) === s);
  if (garden) return { href: `/garden/${bare(garden.id)}/`, label: garden.data.plant };
  return null;
}

// Group ingredients by `group` field, preserving order of first occurrence.
const groups = new Map<string, typeof recipe.data.ingredients>();
for (const ing of recipe.data.ingredients) {
  const k = ing.group ?? '';
  if (!groups.has(k)) groups.set(k, []);
  groups.get(k)!.push(ing);
}

function isoMinutes(s: string | undefined): number {
  if (!s) return 0;
  const trimmed = s.trim().toLowerCase();
  const hours = Number(trimmed.match(/(\d+(?:\.\d+)?)\s*h(?:our)?s?/)?.[1] ?? 0);
  const minutes = Number(trimmed.match(/(\d+(?:\.\d+)?)\s*m(?:in)?(?:ute)?s?/)?.[1] ?? 0);
  return Math.round(hours * 60 + minutes);
}

/** Returns undefined for unparseable / zero inputs; schema.org tolerates absence. */
function isoDuration(minutes: number): string | undefined {
  if (minutes === 0) return undefined;
  const h = Math.floor(minutes / 60);
  const m = minutes % 60;
  return `PT${h ? `${h}H` : ''}${m ? `${m}M` : ''}`;
}

const site = Astro.site!;
const recipeUrl = entryUrl(site, 'recipes', slug);
// Strip <em> markup from the recipe title for the meta description (plain text only).
const plainTitle = recipe.data.title.replace(/<\/?em>/g, '');
const description = [
  plainTitle,
  recipe.data.yield,
  recipe.data.timePrep && `prep ${recipe.data.timePrep}`,
  recipe.data.timeCook && `cook ${recipe.data.timeCook}`,
  recipe.data.attribution && `via ${recipe.data.attribution}`,
].filter(Boolean).join(' · ').slice(0, 155);
const prepMin = isoMinutes(recipe.data.timePrep);
const cookMin = isoMinutes(recipe.data.timeCook);
const prepIso = isoDuration(prepMin);
const cookIso = isoDuration(cookMin);
const totalIso = isoDuration(prepMin + cookMin);

// Derive schema.org fields from the project's tag enum (see src/content.config.ts).
const CUISINE_TAGS = new Set([
  'italian', 'japanese', 'chinese', 'french', 'mexican', 'thai',
  'indian', 'levantine', 'iberian', 'nordic',
]);
const CATEGORY_TAGS = new Set(['breakfast', 'lunch', 'dinner', 'snack', 'dessert', 'drink']);
// schema.org RestrictedDiet vocabulary — vegan implies vegetarian, so emit both.
const DIET_URI: Partial<Record<typeof recipe.data.tags[number], string[]>> = {
  vegan: ['https://schema.org/VeganDiet', 'https://schema.org/VegetarianDiet'],
  vegetarian: ['https://schema.org/VegetarianDiet'],
  pescatarian: ['https://schema.org/PescetarianDiet'],
};
const cuisines = recipe.data.tags.filter((t) => CUISINE_TAGS.has(t));
const categories = recipe.data.tags.filter((t) => CATEGORY_TAGS.has(t));
const suitableForDiet = [...new Set(recipe.data.tags.flatMap((t) => DIET_URI[t] ?? []))];

// Revisions are authored chronologically; first is earliest, last is most recent.
const revisions = recipe.data.revisions;
const datePublished = revisions[0]?.date;
const dateModified = revisions[revisions.length - 1]?.date;

const recipeLd = {
  '@context': SCHEMA_CTX,
  '@type': 'Recipe',
  name: recipe.data.title,
  description,
  recipeYield: recipe.data.yield,
  url: recipeUrl,
  inLanguage: 'en',
  // schema.org wants plain ingredient strings; entry-page UI keeps the structured refs.
  recipeIngredient: recipe.data.ingredients.map((i) => i.text),
  recipeInstructions: recipe.data.steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    text: s.text,
  })),
  ...(prepIso && { prepTime: prepIso }),
  ...(cookIso && { cookTime: cookIso }),
  ...(totalIso && { totalTime: totalIso }),
  ...(recipe.data.heroUrl && { image: recipe.data.heroUrl }),
  ...(recipe.data.attribution && { author: { '@type': 'Person', name: recipe.data.attribution } }),
  ...(datePublished && { datePublished }),
  ...(dateModified && dateModified !== datePublished && { dateModified }),
  ...(cuisines.length > 0 && { recipeCuisine: cuisines }),
  ...(categories.length > 0 && { recipeCategory: categories }),
  ...(suitableForDiet.length > 0 && { suitableForDiet }),
  ...(recipe.data.tags.length > 0 && { keywords: recipe.data.tags.join(', ') }),
};

const breadcrumbLd = breadcrumb(
  site,
  { label: 'Recipes', kind: 'recipes' },
  { label: recipe.data.title, url: recipeUrl },
);
---

<BaseLayout
  title={recipe.data.title}
  description={description}
  unlisted={recipe.data.visibility === 'unlisted'}
  hero={recipe.data.hero}
  heroUrl={recipe.data.heroUrl}
  ogType="article"
>
  <JsonLd data={recipeLd} />
  <JsonLd data={breadcrumbLd} />
  <section class="container recipe">
    <p class="eyebrow">Recipe</p>
    <h1>{recipe.data.title}</h1>
    <p class="lead">
      {recipe.data.yield}
      {recipe.data.timePrep && <> · prep {recipe.data.timePrep}</>}
      {recipe.data.timeCook && <> · cook {recipe.data.timeCook}</>}
    </p>

    <p class="cook-link">
      <a href={`/recipes/${slug}/cook/`}>→ Open in cook mode</a>
    </p>

    {recipe.data.tags.length > 0 && (
      <ul class="tag-chips" aria-label="Tags">
        {recipe.data.tags.map((t) => <li>{t}</li>)}
      </ul>
    )}

    {recipe.data.attribution && <p class="attribution">{recipe.data.attribution}</p>}

    <h2>Ingredients</h2>
    {[...groups.entries()].map(([groupName, items]) => (
      <>
        {groupName && <h3 class="group-heading">{groupName}</h3>}
        <ul>
          {items.map((ing) => {
            const producer = ing.from ? findProducer(ing.from) : null;
            return (
              <li>
                {ing.text}
                {producer && <> — <a href={producer.href}>{producer.label}</a></>}
                {ing.from && !producer && <> — <span>{ing.from}</span></>}
              </li>
            );
          })}
        </ul>
      </>
    ))}

    <h2>Method</h2>
    <ol class="method">
      {recipe.data.steps.map((step) => (
        <li>
          {step.text}
          {step.durationSeconds && (
            <span class="step-duration">· {Math.round(step.durationSeconds / 60)} min</span>
          )}
        </li>
      ))}
    </ol>

    {/* MDX body — author prose, renders nothing when the body is empty. */}
    <Content />

    {recipe.data.notes && (
      <>
        <h2>Notes</h2>
        <pre class="notes">{recipe.data.notes}</pre>
      </>
    )}

    <AppearsIn dishes={dishesUsingThisRecipe} label="Cooked in" />

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <p class="eyebrow" id="related-heading">More like this</p>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/recipes/${bare(r.id)}/`}>{r.data.title}</a>
              <span class="meta">{[r.data.yield, r.data.timeCook].filter(Boolean).join(' · ')}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <Pager
      ariaLabel="Other recipes"
      prev={prev ? { href: `/recipes/${bare(prev.id)}/`, title: prev.data.title } : null}
      next={next ? { href: `/recipes/${bare(next.id)}/`, title: next.data.title } : null}
    />
  </section>
</BaseLayout>

<style>
  .recipe { padding: 4rem 0; }
  .recipe .cook-link { margin-top: 1.5rem; }
  .recipe .cook-link a { font-weight: 500; }
  .recipe .attribution {
    color: var(--ink-mute);
    font-size: 0.88rem;
    margin-top: 1rem;
  }
  .recipe h2 { margin-top: 3rem; }
  .recipe .group-heading { margin-top: 1.5rem; }
  .recipe .method li { margin-bottom: 1rem; }
  .recipe .step-duration {
    color: var(--ink-mute);
    margin-left: 0.5rem;
    font-size: 0.9rem;
  }
  .recipe .notes {
    white-space: pre-wrap;
    font-family: var(--font-body);
    color: var(--ink-soft);
  }
  .recipe .tag-chips { margin-top: 1.5rem; }
  .recipe .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .recipe .related ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .recipe .related a {
    font-family: var(--font-display);
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--ink);
  }
  .recipe .related a:hover { color: var(--paprika); }
  .recipe .related .meta { color: var(--ink-mute); font-size: 0.85rem; margin-left: 0.5rem; }
</style>
