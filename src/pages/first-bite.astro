---
/**
 * /first-bite — a curated 9-dish sampler. One dish each from nine
 * different angles: cuisines, techniques, occasions. Designed as a
 * "where do I start?" landing for new visitors.
 *
 * Selection rotates monthly so repeat visitors see fresh combos.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd from '~/components/JsonLd.astro';
import { SCHEMA_CTX } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

type DishEntry = Awaited<ReturnType<typeof getCollection<'dishes'>>>[number];

const dishes = publicOnly(await getCollection('dishes'))
  .sort((a, b) => bare(a.id).localeCompare(bare(b.id)));

const now = new Date();
const monthIdx = now.getUTCFullYear() * 12 + now.getUTCMonth();

interface Angle { label: string; pick: (d: DishEntry) => boolean; offset: number; }
const ANGLES: Angle[] = [
  { label: 'A weeknight', pick: (d) => d.data.tags.some((t) => ['one-pot', 'breakfast', 'snack'].includes(t)), offset: 0 },
  { label: 'A weekend', pick: (d) => d.data.tags.some((t) => ['baking', 'fermentation', 'grill'].includes(t)), offset: 1 },
  { label: 'Italian', pick: (d) => d.data.tags.includes('italian'), offset: 2 },
  { label: 'Japanese', pick: (d) => d.data.tags.includes('japanese'), offset: 3 },
  { label: 'Indian', pick: (d) => d.data.tags.includes('indian'), offset: 4 },
  { label: 'Plant-led', pick: (d) => d.data.tags.includes('vegetarian'), offset: 5 },
  { label: 'A showpiece', pick: (d) => d.data.tags.includes('dessert'), offset: 6 },
  { label: 'No heat', pick: (d) => d.data.tags.includes('raw'), offset: 7 },
  { label: 'A classic', pick: (d) => d.data.tags.some((t) => ['french', 'chinese', 'levantine'].includes(t)), offset: 8 },
];

interface Pick { angle: string; dish: DishEntry; }
const picks: Pick[] = ANGLES
  .map(({ label, pick, offset }) => {
    const matches = dishes.filter(pick);
    if (matches.length === 0) return null;
    const d = matches[(monthIdx + offset) % matches.length];
    return { angle: label, dish: d };
  })
  .filter((x): x is Pick => x !== null);

const site = Astro.site!;
const webPageLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebPage',
  name: 'First bite',
  url: new URL('/first-bite/', site).toString(),
  description: `Nine dishes from nine angles — rotated monthly.`,
};
---

<BaseLayout title="First bite" description="Nine dishes from nine angles. Where to start.">
  <JsonLd data={webPageLd} />
  <article class="fb container">
    <header class="fb-head">
      <p class="eyebrow">New here?</p>
      <h1>First bite</h1>
      <p class="lead">
        Nine dishes from nine angles — a sampler if you don't know where to start.
        The set rotates monthly, so coming back gets you fresh combos.
      </p>
    </header>

    <ul class="fb-grid">
      {picks.map((p) => {
        const photo = p.dish.data.heroUrl ?? (p.dish.data.hero ? `${p.dish.data.hero}-1280.jpg` : null);
        return (
          <li>
            <a class="fb-card" href={`/dishes/${bare(p.dish.id)}/`}>
              {photo && (
                <div
                  class="fb-photo"
                  style={`background-image: url('${photo}'); background-position: ${p.dish.data.heroFocal ?? 'center'};`}
                />
              )}
              <div class="fb-overlay"></div>
              <div class="fb-text">
                <p class="fb-angle">{p.angle}</p>
                <h2 class="fb-title" set:html={p.dish.data.title} />
              </div>
            </a>
          </li>
        );
      })}
    </ul>

    <p class="fb-footnote">
      Or pick yourself: <a href="/dishes/">browse all dishes</a> · <a href="/random/">surprise me</a> · <a href="/today/">today's pick</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .fb { padding: 4rem 0 6rem; max-width: 1200px; }
  .fb-head { margin-bottom: 3rem; max-width: 60ch; }
  .fb-head h1 { margin: 0.4rem 0 0.8rem; }
  .fb-head .lead { color: var(--ink-soft); margin: 0; }

  .fb-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }
  .fb-grid li { padding: 0; max-width: none; }

  .fb-card {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    background: #11161c;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    box-shadow: 0 4px 14px -6px rgba(0, 0, 0, 0.45);
  }
  .fb-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px -10px rgba(0, 0, 0, 0.6);
  }
  .fb-photo {
    position: absolute;
    inset: 0;
    background-size: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .fb-card:hover .fb-photo { transform: scale(1.04); }
  .fb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgba(0,0,0,0.85) 100%);
  }
  .fb-text {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.2rem 1.4rem 1.4rem;
    z-index: 1;
  }
  .fb-angle {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paprika);
    font-weight: 600;
    margin: 0 0 0.4rem;
    text-shadow: 0 1px 3px rgba(0,0,0,0.7);
  }
  .fb-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.05;
    margin: 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.75);
  }

  .fb-footnote {
    margin-top: 3rem;
    color: var(--ink-mute);
    font-size: 0.92rem;
  }
  .fb-footnote a {
    color: var(--paprika);
    text-decoration: none;
    border-bottom: 1px dotted var(--paprika);
  }
  .fb-footnote a:hover { color: var(--ink); border-color: var(--ink); }

  @media (max-width: 880px) {
    .fb-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .fb-grid { grid-template-columns: 1fr; }
  }
</style>
