---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd from '~/components/JsonLd.astro';
import { SCHEMA_CTX, breadcrumb, sectionUrl } from '~/lib/jsonld';
import { resolveProducer } from '~/lib/producers';

const pantry = await getEntry('pantry', 'pantry');
if (!pantry) throw new Error('pantry.mdx missing — collection schema requires it');
const { items, updated } = pantry.data;

const farms = await getCollection('farms');
const gardens = await getCollection('garden');

const site = Astro.site!;
const description = `Pantry snapshot — ${items.length} items in stock${updated ? ` as of ${updated}` : ''}.`;
const webPageLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebPage',
  name: 'Pantry',
  url: sectionUrl(site, 'pantry'),
  description,
  inLanguage: 'en',
  ...(updated && { dateModified: updated }),
};
const crumb = breadcrumb(site, { label: 'Pantry', kind: 'pantry' });
---

<BaseLayout title="Pantry" description={description}>
  <JsonLd data={webPageLd} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Stock</p>
    <h1>Pantry</h1>
    <p class="lead">
      What's currently on hand. The provenance link points to the farm or producer when known.
    </p>
    <ul class="pantry-stats" aria-label="Pantry scope">
      <li><strong>{items.length}</strong>{items.length === 1 ? 'item' : 'items'}</li>
      <li><strong>{items.filter((i) => i.from).length}</strong>with provenance</li>
      {updated && <li class="pantry-stats-when"><span class="when-label">Updated</span><strong>{updated}</strong></li>}
    </ul>

    {items.length === 0 ? (
      <p class="muted">The pantry is empty right now.</p>
    ) : (
      <ul class="index-list divided">
        {items.map((item) => {
          const producer = item.from ? resolveProducer(item.from, { farms, gardens }) : null;
          const provenanceText = producer ? null : item.from;
          const hasMeta = Boolean(item.quantity || producer || provenanceText);
          const sep = item.quantity && (producer || provenanceText) ? ' · ' : '';
          return (
            <li>
              <span class="label">{item.label}</span>
              {hasMeta && (
                <span class="meta">
                  {item.quantity}{sep}
                  {producer && <a href={producer.href}>{producer.label}</a>}
                  {provenanceText}
                </span>
              )}
            </li>
          );
        })}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .label { font-family: var(--font-display); font-size: 1.05rem; }
  .muted { color: var(--ink-mute); }
  .pantry-stats {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--ink-mute);
    font-size: 0.92rem;
  }
  .pantry-stats li { padding: 0; max-width: none; display: flex; gap: 0.4rem; align-items: baseline; }
  .pantry-stats strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--paprika);
    font-weight: 500;
  }
  .pantry-stats-when .when-label {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .pantry-stats-when strong {
    font-size: 0.95rem;
    color: var(--ink);
  }
</style>
