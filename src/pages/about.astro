---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { publicOnly } from '~/lib/visibility';

const [dishes, recipes, farms, restaurants, garden] = await Promise.all([
  getCollection('dishes').then(publicOnly),
  getCollection('recipes').then(publicOnly),
  getCollection('farms').then(publicOnly),
  getCollection('restaurants').then(publicOnly),
  getCollection('garden').then(publicOnly),
]);
const stats = [
  { label: 'Dishes', count: dishes.length, href: '/dishes/' },
  { label: 'Recipes', count: recipes.length, href: '/recipes/' },
  { label: 'Farms & producers', count: farms.length, href: '/farms/' },
  { label: 'Restaurants', count: restaurants.length, href: '/restaurants/' },
  { label: 'Garden beds', count: garden.length, href: '/garden/' },
].filter((s) => s.count > 0);
---

<BaseLayout
  title="About"
  description="An archive of the food lifecycle — farms, gardens, kitchens, restaurants. What Foodbook is, what it isn't, and where AI lives in it."
>
  <article class="about container">
    <p class="eyebrow">About</p>
    <h1>An archive of the food lifecycle</h1>

    <p class="lead">
      Foodbook follows a dish — or an ingredient — through up to four lifecycle stages:
      the farm that grew it, the garden that nurtured it, the kitchen that cooked it,
      the meal where it landed. Each <a href="/dishes/">dish entry</a> weaves them together.
    </p>

    <h2>By the numbers</h2>
    <dl class="about-stats">
      {stats.map((s) => (
        <div class="about-stat">
          <dt><a href={s.href}>{s.label}</a></dt>
          <dd>{s.count}</dd>
        </div>
      ))}
    </dl>

    <h2 id="ai">AI-assisted authoring</h2>

    <p>
      Foodbook uses Claude (Anthropic) for <em>authoring assistance</em>, not authorship.
      The editorial voice is the author's. AI does extraction and discovery; the prose is hand-written.
    </p>

    <p>
      <strong>What's shipped today:</strong> a CLI extraction pipeline
      (<code>npm&nbsp;run&nbsp;extract</code>) that reads a URL or photo, asks Claude
      with vision + structured output for a draft, and writes the result to
      <code>src/content/recipes/_drafts/</code>. The draft is never auto-committed —
      every recipe is edited by hand before it lands on the site.
    </p>

    <p>
      <strong>What's designed but not running yet:</strong> a reader-side
      conversational search (RAG over the corpus, with citations by slug); a
      cook-mode voice + chat coach with <code>set_timer</code> and
      <code>advance_step</code> tools; a "more like this" related-entries rail.
      The full plan, including non-goals (no AI prose, no AI photos, no AI
      reranking the canonical lists), is in
      <a href="https://github.com/laichunpongben/foodbook/blob/main/docs/ai-first.md">docs/ai-first.md</a>.
    </p>

    <p>
      Where Claude is involved, the dish or recipe carries an
      <code>attribution</code> field naming the source.
    </p>

    <h2>Source</h2>

    <p>
      The codebase is at
      <a href="https://github.com/laichunpongben/foodbook">github.com/laichunpongben/foodbook</a>
      — issues and PRs welcome.
    </p>
  </article>
</BaseLayout>

<style>
  .about { padding: 4rem 0 6rem; max-width: 720px; }
  .about h1 { margin-bottom: 1.5rem; }
  .about h2 { margin-top: 3rem; }
  .about p { color: var(--ink-soft); }
  .about a { color: var(--paprika); }

  .about-stats {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .about-stat {
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 1rem 1.1rem;
    background: rgba(250, 248, 244, 0.02);
  }
  .about-stat dt {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0;
  }
  .about-stat dt a { color: var(--ink-mute); text-decoration: none; }
  .about-stat dt a:hover { color: var(--paprika); }
  .about-stat dd {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--ink);
    margin: 0.4rem 0 0;
    line-height: 1;
    font-feature-settings: 'tnum';
  }
</style>
