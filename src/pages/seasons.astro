---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd from '~/components/JsonLd.astro';
import SeasonalWheel from '~/components/SeasonalWheel.astro';
import { SCHEMA_CTX, breadcrumb, sectionUrl } from '~/lib/jsonld';
import {
  collectProducts,
  inSeason,
  MONTH_NAMES_LONG,
} from '~/lib/seasons';
import { publicOnly } from '~/lib/visibility';

const farms = publicOnly(await getCollection('farms'));
const month = new Date().getMonth() + 1; // 1-12
const nextMonth = (month % 12) + 1;

const products = collectProducts(farms);
const inSeasonNow = products.filter((p) => inSeason(p.from, p.to, month));
// "Coming soon" — newly entering season next month (not already in season now).
const comingSoon = products.filter(
  (p) => !inSeason(p.from, p.to, month) && inSeason(p.from, p.to, nextMonth),
);

const site = Astro.site!;
const description = `What's in season this ${MONTH_NAMES_LONG[month - 1]} — ${inSeasonNow.length} products drawn from farm + producer windows.`;
const webPageLd = {
  '@context': SCHEMA_CTX,
  '@type': 'WebPage',
  name: 'Seasons',
  url: sectionUrl(site, 'seasons'),
  description,
  inLanguage: 'en',
};
const crumb = breadcrumb(site, { label: 'Seasons', kind: 'seasons' });
---

<BaseLayout title="Seasons" description={description}>
  <JsonLd data={webPageLd} />
  <JsonLd data={crumb} />
  <section class="container" style="padding: 4rem 0;">
    <p class="eyebrow">{MONTH_NAMES_LONG[month - 1]}</p>
    <h1>In season now</h1>
    <p class="lead">
      Each ring is a product authored on a farm or producer entry. The wedge
      glowing behind the wheel is the current month — products falling inside
      it are filled paprika.
    </p>

    <SeasonalWheel farms={farms} currentMonth={month} />

    <div class="legend">
      <h2>Right now</h2>
      {inSeasonNow.length === 0 ? (
        <p class="muted">No products have a window covering {MONTH_NAMES_LONG[month - 1]} yet.</p>
      ) : (
        <ul>
          {inSeasonNow.map((p) => (
            <li>
              <strong>{p.product}</strong>
              <span class="muted"> — {p.farms.map((f) => f.name).join(', ')}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    {comingSoon.length > 0 && (
      <div class="legend coming-soon">
        <h2>Coming in {MONTH_NAMES_LONG[nextMonth - 1]}</h2>
        <p class="muted">Newly entering season next month — plan ahead.</p>
        <ul>
          {comingSoon.map((p) => (
            <li>
              <strong>{p.product}</strong>
              <span class="muted"> — {p.farms.map((f) => f.name).join(', ')}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .legend {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .legend h2 {
    margin-bottom: 1rem;
  }

  .legend ul {
    columns: 2;
    column-gap: 2rem;
    padding: 0;
    list-style: none;
    margin: 0;
  }

  .legend li {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
    max-width: none;
  }

  .legend .muted {
    color: var(--ink-mute);
  }
</style>
