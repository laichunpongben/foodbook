---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

// shortTitle drives the sort key because title may contain authored <em>.
const dishes = publicOnly(await getCollection('dishes')).sort((a, b) =>
  a.data.shortTitle.localeCompare(b.data.shortTitle, undefined, { sensitivity: 'base' }),
);
const description = `${dishes.length} dishes in the archive.`;
const section = { label: 'Dishes', kind: 'dishes' };
const items = dishes.map((d) => ({
  name: d.data.shortTitle,
  url: entryUrl(Astro.site!, 'dishes', bare(d.id)),
  ...(d.data.tagline && { description: d.data.tagline }),
}));
const ld = collectionPage(Astro.site!, { ...section, description }, items);
const crumb = breadcrumb(Astro.site!, section);
---

<BaseLayout title="Dishes" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Dishes</p>
    <h1>Dishes</h1>
    <p class="lead">Every dish in the archive — {dishes.length} entries, alphabetical.</p>

    <ul class="index-list dish-list">
      {dishes.map((d) => {
        const photoUrl = d.data.heroUrl ?? (d.data.hero ? `${d.data.hero}-640.jpg` : null);
        return (
          <li class="dish-list-item">
            {photoUrl && (
              <a class="dish-list-thumb" href={`/dishes/${bare(d.id)}/`} aria-hidden="true" tabindex="-1">
                <img src={photoUrl} alt="" loading="lazy" decoding="async" style={d.data.heroFocal ? `object-position: ${d.data.heroFocal}` : undefined} />
              </a>
            )}
            <div class="dish-list-text">
              <a href={`/dishes/${bare(d.id)}/`} set:html={d.data.title} />
              {d.data.tagline && <span class="tagline">{d.data.tagline}</span>}
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>

<style>
  .dish-list { gap: 0.6rem; }
  .dish-list-item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 1.2rem;
    align-items: center;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--rule);
    max-width: none;
  }
  .dish-list-thumb {
    display: block;
    width: 88px;
    height: 88px;
    border-radius: 6px;
    overflow: hidden;
    background: #11161c;
  }
  .dish-list-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .dish-list-item:hover .dish-list-thumb img { transform: scale(1.05); }
  .dish-list-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .dish-list-text a { font-size: 1.25rem; }
  @media (max-width: 480px) {
    .dish-list-item { grid-template-columns: 60px 1fr; gap: 0.9rem; }
    .dish-list-thumb { width: 60px; height: 60px; }
  }
</style>
