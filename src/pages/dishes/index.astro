---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

// shortTitle drives the sort key because title may contain authored <em>.
const dishes = publicOnly(await getCollection('dishes')).sort((a, b) =>
  a.data.shortTitle.localeCompare(b.data.shortTitle, undefined, { sensitivity: 'base' }),
);

// A-Z jump bar — derive the set of starting letters that have at least
// one dish, so the bar only lights letters that go somewhere.
function firstLetter(s: string): string {
  const c = s.trim().charAt(0).toUpperCase();
  return /[A-Z]/.test(c) ? c : '#';
}
const lettersPresent = new Set<string>();
const sectionByLetter = new Map<string, typeof dishes>();
for (const d of dishes) {
  const letter = firstLetter(d.data.shortTitle);
  lettersPresent.add(letter);
  const list = sectionByLetter.get(letter) ?? [];
  list.push(d);
  sectionByLetter.set(letter, list);
}
const ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');

const description = `${dishes.length} dishes in the archive.`;
const section = { label: 'Dishes', kind: 'dishes' };
const items = dishes.map((d) => ({
  name: d.data.shortTitle,
  url: entryUrl(Astro.site!, 'dishes', bare(d.id)),
  ...(d.data.tagline && { description: d.data.tagline }),
}));
const ld = collectionPage(Astro.site!, { ...section, description }, items);
const crumb = breadcrumb(Astro.site!, section);
---

<BaseLayout title="Dishes" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Dishes</p>
    <h1>Dishes</h1>
    <p class="lead">Every dish in the archive — {dishes.length} entries, alphabetical.</p>

    <nav class="az-bar" aria-label="Jump to letter">
      {ALPHABET.map((letter) => (
        lettersPresent.has(letter) ? (
          <a href={`#${letter}`} class="az-letter">{letter}</a>
        ) : (
          <span class="az-letter az-letter--off" aria-hidden="true">{letter}</span>
        )
      ))}
    </nav>

    {ALPHABET.filter((l) => sectionByLetter.has(l)).concat(sectionByLetter.has('#') ? ['#'] : []).map((letter) => (
      <section class="az-section" id={letter}>
        <h2 class="az-section-head">{letter}</h2>
        <ul class="index-list dish-list">
          {(sectionByLetter.get(letter) ?? []).map((d) => (
            <li>
              <a href={`/dishes/${bare(d.id)}/`} set:html={d.data.title} />
              {d.data.tagline && <span class="tagline">{d.data.tagline}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .az-bar {
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    position: sticky;
    top: 0;
    background: rgba(10, 13, 17, 0.92);
    backdrop-filter: blur(8px);
    z-index: 5;
  }
  .az-letter {
    font-family: var(--font-display);
    font-size: 0.92rem;
    min-width: 1.6em;
    padding: 0.25rem 0.4rem;
    text-align: center;
    color: var(--ink);
    text-decoration: none;
    border-radius: 4px;
    border: 1px solid transparent;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .az-letter:hover {
    border-color: var(--paprika);
    color: var(--paprika);
  }
  .az-letter--off {
    color: var(--ink-mute);
    opacity: 0.4;
    cursor: default;
  }
  .az-section { margin: 2rem 0; scroll-margin-top: 80px; }
  .az-section-head {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--paprika);
    margin: 0 0 0.6rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--rule);
  }
  .dish-list { gap: 1rem; }
  .dish-list li { padding-bottom: 1rem; border-bottom: 1px solid var(--rule); gap: 0.2rem; }
  .dish-list a { font-size: 1.25rem; }
</style>
