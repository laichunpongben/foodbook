---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd from '~/components/JsonLd.astro';
import { SCHEMA_CTX, breadcrumb, entryUrl } from '~/lib/jsonld';
import DishHero from '~/components/DishHero.astro';
import PlantSection from '~/components/PlantSection.astro';
import CookSection from '~/components/CookSection.astro';
import PlateSection from '~/components/PlateSection.astro';
import EatSection from '~/components/EatSection.astro';
import { getJourney } from '~/lib/journey';
import { bareSlug } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

export async function getStaticPaths() {
  const dishes = await getCollection('dishes');
  return dishes.map((dish) => ({
    params: { slug: bareSlug(dish.id) },
    props: { dish },
  }));
}

const { dish } = Astro.props;
const slug = bareSlug(dish.id);
const { Content } = await render(dish);
const journey = await getJourney(dish);

// Prev/next in the same alphabetical-by-shortTitle order as /dishes/.
// Unlisted dishes drop out of the chain (and we don't render the nav on them).
const allPublic = publicOnly(await getCollection('dishes')).sort((a, b) =>
  a.data.shortTitle.localeCompare(b.data.shortTitle, undefined, { sensitivity: 'base' }),
);
const currentIndex = allPublic.findIndex((d) => d.id === dish.id);
const prev = currentIndex > 0 ? allPublic[currentIndex - 1] : null;
const next =
  currentIndex >= 0 && currentIndex < allPublic.length - 1 ? allPublic[currentIndex + 1] : null;

const hasIngredients = journey.ingredients.length > 0;
const hasRecipes = journey.cook.length > 0;
const hasEats = journey.eat.length > 0;
const heroScrollTo: '#plant' | '#cook' | '#plate' =
  hasIngredients ? '#plant' : hasRecipes ? '#cook' : '#plate';

const site = Astro.site!;
const dishUrl = entryUrl(site, 'dishes', slug);
const articleLd = {
  '@context': SCHEMA_CTX,
  '@type': 'Article',
  headline: dish.data.shortTitle,
  url: dishUrl,
  ...(dish.data.tagline && { description: dish.data.tagline }),
  ...(dish.data.heroUrl && { image: dish.data.heroUrl }),
  ...(dish.data.firstMade && { dateCreated: dish.data.firstMade }),
  ...(dish.data.origin && { about: dish.data.origin }),
};

const breadcrumbLd = breadcrumb(
  site,
  { label: 'Dishes', kind: 'dishes' },
  { label: dish.data.shortTitle, url: dishUrl },
);
---

<BaseLayout
  title={dish.data.shortTitle}
  description={dish.data.tagline}
  unlisted={dish.data.visibility === 'unlisted'}
  hero={dish.data.hero}
  heroUrl={dish.data.heroUrl}
  ogType="article"
>
  <JsonLd data={articleLd} />
  <JsonLd data={breadcrumbLd} />
  <article class="dish-journey">
    <DishHero dish={dish} scrollTo={heroScrollTo} />

    {hasIngredients && <PlantSection ingredients={journey.ingredients} />}
    {hasRecipes && <CookSection recipes={journey.cook} />}
    <PlateSection dish={journey.dish} />
    {hasEats && <EatSection eats={journey.eat} />}

    <section class="dish-prose">
      <div class="container">
        <Content />

        {dish.data.finale && (
          <section class="finale">
            <h2 set:html={dish.data.finale.heading} />
            <p set:html={dish.data.finale.prose} />
          </section>
        )}

        {(prev || next) && (
          <nav class="dish-pager" aria-label="Other dishes">
            {prev && (
              <a class="pager-link prev" href={`/dishes/${bareSlug(prev.id)}/`} rel="prev">
                <span class="pager-eyebrow">Previous</span>
                <span class="pager-title" set:html={prev.data.title} />
              </a>
            )}
            {next && (
              <a class="pager-link next" href={`/dishes/${bareSlug(next.id)}/`} rel="next">
                <span class="pager-eyebrow">Next</span>
                <span class="pager-title" set:html={next.data.title} />
              </a>
            )}
          </nav>
        )}
      </div>
    </section>
  </article>
</BaseLayout>

<style is:global>
  /* Shared rhythm across all section components — global so each
   * section component doesn't have to redeclare the same eyebrow + */
  .journey-section { width: 100%; }

  .journey-section .stage-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0;
    padding: 0.32rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: rgba(15, 18, 24, 0.5);
    backdrop-filter: blur(4px);
  }
</style>

<style>
  .dish-prose {
    background: rgba(10, 13, 17, 1);
    padding: 5rem 0 7rem;
  }

  .dish-prose .finale {
    margin: 2.5rem 0;
    max-width: var(--measure);
  }

  .dish-prose .finale h2 {
    margin-bottom: 0.6rem;
  }

  .dish-pager {
    display: flex;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-decoration: none;
    color: var(--ink);
    max-width: 18rem;
  }
  .pager-link.next { margin-left: auto; text-align: right; align-items: flex-end; }
  .pager-link:hover .pager-title { color: var(--paprika); }
  .pager-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .pager-title { font-family: var(--font-display); font-size: 1.1rem; }
</style>
