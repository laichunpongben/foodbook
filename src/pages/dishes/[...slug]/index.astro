---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import JsonLd from '~/components/JsonLd.astro';
import { SCHEMA_CTX, breadcrumb, entryUrl } from '~/lib/jsonld';
import DishHero from '~/components/DishHero.astro';
import PlantSection from '~/components/PlantSection.astro';
import CookSection from '~/components/CookSection.astro';
import PlateSection from '~/components/PlateSection.astro';
import EatSection from '~/components/EatSection.astro';
import Pager from '~/components/Pager.astro';
import { getJourney } from '~/lib/journey';
import { relatedByTags } from '~/lib/related';
import { siblingsOf } from '~/lib/siblings';
import { bareSlug } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

export async function getStaticPaths() {
  const dishes = await getCollection('dishes');
  const allPublic = publicOnly(dishes);
  return dishes.map((dish) => ({
    params: { slug: bareSlug(dish.id) },
    props: { dish, allPublic },
  }));
}

const { dish, allPublic } = Astro.props;
const slug = bareSlug(dish.id);
const { Content } = await render(dish);
const journey = await getJourney(dish);

const { prev, next } = await siblingsOf('dishes', dish.id, (d) => d.data.shortTitle);
const related = relatedByTags(allPublic, dish, (d) => d.data.shortTitle);

const hasIngredients = journey.ingredients.length > 0;
const hasRecipes = journey.cook.length > 0;
const hasEats = journey.eat.length > 0;
const heroScrollTo: '#plant' | '#cook' | '#plate' =
  hasIngredients ? '#plant' : hasRecipes ? '#cook' : '#plate';

const site = Astro.site!;
const dishUrl = entryUrl(site, 'dishes', slug);
const articleLd = {
  '@context': SCHEMA_CTX,
  '@type': 'Article',
  headline: dish.data.shortTitle,
  url: dishUrl,
  inLanguage: 'en',
  ...(dish.data.tagline && { description: dish.data.tagline }),
  ...(dish.data.heroUrl && { image: dish.data.heroUrl }),
  ...(dish.data.firstMade && { dateCreated: dish.data.firstMade }),
  ...(dish.data.origin && { about: dish.data.origin }),
  ...(dish.data.tags.length > 0 && { keywords: dish.data.tags.join(', ') }),
};

const breadcrumbLd = breadcrumb(
  site,
  { label: 'Dishes', kind: 'dishes' },
  { label: dish.data.shortTitle, url: dishUrl },
);
---

<BaseLayout
  title={dish.data.shortTitle}
  description={dish.data.tagline}
  unlisted={dish.data.visibility === 'unlisted'}
  hero={dish.data.hero}
  heroUrl={dish.data.heroUrl}
  ogType="article"
>
  <JsonLd data={articleLd} />
  <JsonLd data={breadcrumbLd} />
  <article class="dish-journey">
    <DishHero dish={dish} scrollTo={heroScrollTo} />

    {hasIngredients && <PlantSection ingredients={journey.ingredients} />}
    {hasRecipes && <CookSection recipes={journey.cook} />}
    <PlateSection dish={journey.dish} />
    {hasEats && <EatSection eats={journey.eat} />}

    <section class="dish-prose">
      <div class="container">
        <Content />

        {dish.data.finale && (
          <section class="finale">
            <h2 set:html={dish.data.finale.heading} />
            <p set:html={dish.data.finale.prose} />
          </section>
        )}

        {related.length > 0 && (
          <section class="related" aria-labelledby="related-heading">
            <p class="eyebrow" id="related-heading">More like this</p>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={`/dishes/${bareSlug(r.id)}/`} set:html={r.data.title} />
                  {r.data.tagline && <span class="meta">{r.data.tagline}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        <Pager
          ariaLabel="Other dishes"
          prev={prev ? { href: `/dishes/${bareSlug(prev.id)}/`, title: prev.data.title } : null}
          next={next ? { href: `/dishes/${bareSlug(next.id)}/`, title: next.data.title } : null}
        />
      </div>
    </section>
  </article>
</BaseLayout>

<style is:global>
  /* Shared rhythm across all section components — global so each
   * section component doesn't have to redeclare the same eyebrow + */
  .journey-section { width: 100%; }

  .journey-section .stage-eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0;
    padding: 0.32rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: rgba(15, 18, 24, 0.5);
    backdrop-filter: blur(4px);
  }
</style>

<style>
  .dish-prose {
    background: rgba(10, 13, 17, 1);
    padding: 5rem 0 7rem;
  }

  .dish-prose .finale {
    margin: 2.5rem 0;
    max-width: var(--measure);
  }

  .dish-prose .finale h2 {
    margin-bottom: 0.6rem;
  }

  .dish-prose .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .dish-prose .related ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .dish-prose .related a {
    font-family: var(--font-display);
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--ink);
  }
  .dish-prose .related a:hover { color: var(--paprika); }
  .dish-prose .related .meta { color: var(--ink-mute); font-size: 0.85rem; margin-left: 0.5rem; }
</style>
