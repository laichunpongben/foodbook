---
import { getCollection } from 'astro:content';
import JsonLd from '~/components/JsonLd.astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { breadcrumb, collectionPage, entryUrl } from '~/lib/jsonld';
import { bare } from '~/lib/slug';
import { publicOnly } from '~/lib/visibility';

const restaurants = publicOnly(await getCollection('restaurants')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);

// Pre-sorted by name above; Map preserves insertion order, so each
// city group inherits alphabetical order without a second sort.
const byCity = new Map<string, typeof restaurants>();
for (const r of restaurants) {
  const list = byCity.get(r.data.city) ?? [];
  list.push(r);
  byCity.set(r.data.city, list);
}
const cities = [...byCity.entries()].sort(([a], [b]) => a.localeCompare(b));
const description = `${restaurants.length} restaurants in the archive.`;
const section = { label: 'Restaurants', kind: 'restaurants' };
const items = restaurants.map((r) => ({
  name: r.data.name,
  url: entryUrl(Astro.site!, 'restaurants', bare(r.id)),
  description: `${r.data.cuisine ?? 'Restaurant'} in ${r.data.city}`,
}));
const ld = collectionPage(Astro.site!, { ...section, description }, items);
const crumb = breadcrumb(Astro.site!, section);
---

<BaseLayout title="Restaurants" description={description}>
  <JsonLd data={ld} />
  <JsonLd data={crumb} />
  <section class="container index-page">
    <p class="eyebrow">Eat</p>
    <h1>Restaurants</h1>
    <p class="lead">
      Visited and discovered. See also: <a href="/world/">the map</a> or <a href="/atlas/">by country</a>.
    </p>
    <ul class="index-stats" aria-label="Eat scope">
      <li><strong>{restaurants.length}</strong> restaurants</li>
      <li><strong>{cities.length}</strong> cities</li>
    </ul>

    {cities.map(([city, list]) => (
      <div class="index-group">
        <h2>{city}</h2>
        <ul class="index-list">
          {list.map((r) => (
            <li>
              <a href={`/restaurants/${bare(r.id)}/`}>{r.data.name}</a>
              <span class="meta">
                {[r.data.cuisine, r.data.priceBand].filter(Boolean).join(' · ')}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .index-list { gap: 0.6rem; margin-top: 0.8rem; }
  .index-list a { font-size: 1.1rem; }
  .index-stats {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    color: var(--ink-mute);
    font-size: 0.92rem;
  }
  .index-stats li { padding: 0; max-width: none; }
  .index-stats strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--paprika);
    font-weight: 500;
    margin-right: 0.25rem;
  }
</style>
